---
import type { MarkdownHeading } from 'astro';
import { PUBLIC_R2_URL } from 'astro:env/client';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageNav from '../components/PageNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { faviconUrl } from '../lib/favicon';
import { categorySlug as slugify } from '../lib/posts';

type Props = CollectionEntry<'blog'>['data'] & {
	related?: CollectionEntry<'blog'>[];
	headings?: MarkdownHeading[];
	readingTime?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	keywords,
	canonicalURL,
	noindex,
	ogTitle,
	ogDescription,
	ogImage,
	author,
	category,
	tags = [],
	tldr,
	link,
	related = [],
	headings = [],
	readingTime,
} = Astro.props;

const categorySlug = category && slugify(category);
const resolvedOgImage = ogImage && `${PUBLIC_R2_URL}/og/${ogImage}.webp`;
const linkFavicon = link && faviconUrl(link);
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			keywords={keywords}
			canonicalURL={canonicalURL}
			noindex={noindex}
			ogTitle={ogTitle}
			ogDescription={ogDescription}
			ogImage={resolvedOgImage}
			type="article"
			author={author}
		/>
	</head>
	<body>
		<main>
			<article>
				<header class="post-header">
					<PageNav
						links={[
							{ href: '/blog', label: '← blog' },
							{ href: '/', label: 'home' },
						]}
					/>
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									{' '}
									· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
						{
							category && (
								<span>
									{' '}
									·{' '}
									<a href={`/blog/${categorySlug}`} data-astro-prefetch>
										{category}
									</a>
								</span>
							)
						}
						{readingTime && <span> · {readingTime}</span>}
					</p>
					<h1>{title}</h1>
					{
						link && (
							<p class="post-link">
								<a href={link} target="_blank" rel="noopener">
									<img
										class="link-favicon"
										src={linkFavicon}
										alt=""
										aria-hidden="true"
										loading="lazy"
									/>
									{link}
								</a>
							</p>
						)
					}
					{
						tags.length > 0 && (
							<p class="post-tags">
								{tags.map((tag: string) => (
									<a href={`/tag/${tag}`} class="tag" data-astro-prefetch>
										#{tag}
									</a>
								))}
							</p>
						)
					}
					{
						tldr && (
							<details class="tldr">
								<summary>TL;DR</summary>
								<p>{tldr}</p>
							</details>
						)
					}
				</header>

				<TableOfContents headings={headings} />

				<div class="post-body">
					<div class="prose">
						<slot />
					</div>
				</div>

				{
					related.length > 0 && (
						<aside class="related">
							<p class="related-heading">
								more in{' '}
								<a href={`/blog/${categorySlug}`} data-astro-prefetch>
									{category}
								</a>
							</p>
							<ul>
								{related.map((p) => (
									<li>
										<a href={`/blog/${p.id}/`} data-astro-prefetch>
											{p.data.title}
										</a>
										<span class="date">
											<FormattedDate date={p.data.pubDate} />
										</span>
									</li>
								))}
							</ul>
						</aside>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	body:has(article) main {
		max-width: none;
		padding-left: 0;
		padding-right: 0;
	}
</style>

<style>
	article {
		display: grid;
		grid-template-columns: minmax(0, 1fr) min(var(--max-width), 100% - 2rem) minmax(0, 1fr);
	}
	.post-header {
		grid-column: 2;
		grid-row: 1;
	}
	.post-body {
		grid-column: 2;
		grid-row: 2;
	}
	.related {
		grid-column: 2;
		grid-row: 3;
	}

	@media (min-width: 1700px) {
		article :global(.toc) {
			grid-column: 3;
			grid-row: 2 / span 2;
		}
	}

	.post-header {
		margin-bottom: 2.5rem;
	}
	.post-header h1 {
		margin-top: 0.25rem;
	}
	.post-meta {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0;
	}
	.post-link {
		margin: 0.4rem 0 0;
		font-size: 0.9rem;
	}
	.post-link a {
		color: var(--secondary);
		text-decoration: none;
	}
	.post-link a:hover {
		text-decoration: underline;
	}
	.post-tags {
		margin: 0.4rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.tag {
		font-size: 0.78rem;
		color: var(--muted);
		text-decoration: none;
	}
	.tag:hover {
		color: var(--fg);
	}
	.updated {
		font-style: italic;
	}

	.tldr {
		margin-top: 1rem;
		border: 1px solid var(--border);
		border-left: 3px solid var(--secondary);
		padding: 0.6rem 0.9rem;
	}
	.tldr summary {
		cursor: pointer;
		font-weight: bold;
		font-size: 0.85rem;
		color: var(--secondary);
		user-select: none;
	}
	.tldr[open] summary {
		margin-bottom: 0.5rem;
	}
	.tldr p {
		margin: 0;
		color: var(--secondary);
		font-size: 0.95rem;
	}

	.post-link .link-favicon,
	.prose :global(.link-favicon) {
		display: inline-block;
		margin-right: 0.3em;
		vertical-align: -0.15em;
	}
	.prose :global(.link-favicon) {
		text-decoration: none;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 3rem;
	}

	.related {
		margin-top: 3rem;
	}
	.related-heading {
		font-size: 0.85rem;
		color: var(--muted);
		margin-bottom: 0.5rem;
	}
	.related ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.related li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.3rem 0;
		border-bottom: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.related li:first-child {
		border-top: 1px solid var(--border);
	}
	.related li a {
		text-decoration: none;
	}
	.related li a:hover {
		text-decoration: underline;
	}
</style>
