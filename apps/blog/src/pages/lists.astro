---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lists, previewTitles, PREVIEW_COUNT } from '../data/lists';

const navLinks = [
	{ href: '/', label: '← home' },
	{ href: '/blog', label: 'blog' },
];
---

<BaseLayout
	title="lists"
	description="books, movies, camping spots, and tools I keep coming back to"
	navLinks={navLinks}
>
	<h1>lists</h1>
	<p>Running lists of things I love. Perpetually unfinished.</p>

	{
		lists.map((list) => {
			const titles = previewTitles(list);
			const preview = titles.slice(0, PREVIEW_COUNT);
			const truncated = titles.length > PREVIEW_COUNT;
			return (
				<a class="list" href={`/lists/${list.slug}`}>
					<span class="heading">{list.heading}</span>
					<span class="preview">
						{preview.join(', ')}
						{truncated && '…'}
					</span>
				</a>
			);
		})
	}
</BaseLayout>

<style>
	.list {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin: 1rem 0;
		text-decoration: none;
		color: inherit;
	}
	.heading {
		font-weight: 600;
		color: var(--accent);
		flex-shrink: 0;
	}
	.list:hover .heading {
		text-decoration: underline;
	}
	.preview {
		color: var(--muted);
		font-size: 0.9rem;
		text-align: right;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	@media (max-width: 500px) {
		.list {
			flex-direction: column;
			gap: 0.15rem;
		}
		.preview {
			text-align: left;
		}
	}
</style>
