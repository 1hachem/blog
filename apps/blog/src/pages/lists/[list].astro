---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lists } from '../../data/lists';

export function getStaticPaths() {
	return lists.map((list) => ({
		params: { list: list.slug },
		props: { list },
	}));
}

const { list } = Astro.props;
const navLinks = [
	{ href: '/lists', label: '← lists' },
	{ href: '/', label: 'home' },
];
---

<BaseLayout
	title={list.heading}
	description={list.blurb ?? `my ${list.heading} list`}
	navLinks={navLinks}
>
	<h1>{list.heading}</h1>
	{list.blurb && <p class="blurb">{list.blurb}</p>}

	{
		list.categories.map((category) => (
			<section class="category">
				<h2>{category.name}</h2>
				<ul>
					{category.items.map((item) => (
						<li class:list={{ retired: item.retired }}>
							{item.href ? (
								<a href={item.href} target="_blank" rel="noopener noreferrer">
									{item.title}
								</a>
							) : (
								item.title
							)}
							{item.note && <span class="note"> — {item.note}</span>}
						</li>
					))}
				</ul>
			</section>
		))
	}
</BaseLayout>

<style>
	.blurb {
		color: var(--muted);
		margin: 0 0 1.5rem;
	}
	.category {
		margin: 1.5rem 0;
	}
	.category h2 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0 0 0.5rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		padding: 0.35rem 0;
	}
	li.retired {
		text-decoration: line-through;
		text-decoration-color: var(--muted);
		color: var(--muted);
		font-weight: normal;
		font-size: 0.9rem;
	}
	li.retired a {
		color: var(--muted);
		font-weight: normal;
	}
	.note {
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
