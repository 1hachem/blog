---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingTime } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => {
		const related = post.data.category
			? posts
					.filter((p) => p.id !== post.id && p.data.category === post.data.category)
					.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
					.slice(0, 3)
			: [];
		return {
			params: { slug: post.id },
			props: { post, related },
		};
	});
}

interface Props {
	post: CollectionEntry<'blog'>;
	related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const rt = readingTime(post.body ?? '');
---

<BlogPost {...post.data} readingTime={rt} related={related} headings={headings}>
	<Content />
</BlogPost>
