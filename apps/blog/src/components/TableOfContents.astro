---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	toc.length >= 2 && (
		<div class="toc" data-open="false">
			<div class="toc-inner">
				<button type="button" class="toc-open" aria-expanded="false" aria-controls="toc-panel">
					contents
				</button>
				<div class="toc-panel" id="toc-panel">
					<div class="toc-head">
						<span class="toc-title">contents</span>
						<button type="button" class="toc-close" aria-label="Close table of contents">
							&times;
						</button>
					</div>
					<nav aria-label="Table of contents">
						<ol class="toc-list">
							{toc.map((h) => (
								<li class={h.depth === 3 ? 'toc-h3' : 'toc-h2'} data-id={h.slug}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</nav>
				</div>
			</div>
		</div>
	)
}

<script>
	const GUTTER = '(min-width: 1700px)';
	const STORE = 'toc-open';

	let io: IntersectionObserver | undefined;

	function setupToc() {
		io?.disconnect();

		const toc = document.querySelector<HTMLElement>('.toc');
		if (!toc) return;

		const opener = toc.querySelector<HTMLButtonElement>('.toc-open')!;
		const closer = toc.querySelector<HTMLButtonElement>('.toc-close')!;

		const setOpen = (open: boolean) => {
			toc.dataset.open = String(open);
			opener.setAttribute('aria-expanded', String(open));
		};

		let stored: string | null = null;
		try {
			stored = localStorage.getItem(STORE);
		} catch {}
		setOpen(stored === null ? window.matchMedia(GUTTER).matches : stored === 'true');

		if (!toc.dataset.bound) {
			toc.dataset.bound = 'true';
			const remember = (open: boolean) => {
				setOpen(open);
				try {
					localStorage.setItem(STORE, String(open));
				} catch {}
			};
			opener.addEventListener('click', () => remember(true));
			closer.addEventListener('click', () => remember(false));
			toc.addEventListener('click', (e) => {
				if (!(e.target instanceof Element)) return;
				if (e.target.closest('.toc-list a') && !window.matchMedia(GUTTER).matches) setOpen(false);
			});
		}

		const list = toc.querySelector('.toc-list');
		if (!list) return;

		const items = list.querySelectorAll<HTMLElement>('li[data-id]');
		const idToItem = new Map<string, HTMLElement>();
		for (const item of items) idToItem.set(item.dataset.id!, item);

		const ids = [...idToItem.keys()];
		const headings = ids
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null);

		let activeId = '';
		const setActive = (id: string) => {
			if (id === activeId) return;
			idToItem.get(activeId)?.classList.remove('active');
			activeId = id;
			idToItem.get(activeId)?.classList.add('active');
		};

		const visible = new Set<string>();

		const update = () => {
			const doc = document.documentElement;
			const atBottom = window.innerHeight + Math.ceil(window.scrollY) >= doc.scrollHeight;
			if (atBottom) {
				setActive(ids[ids.length - 1] ?? '');
				return;
			}
			if (visible.size > 0) {
				const first = ids.find((id) => visible.has(id));
				if (first) setActive(first);
				return;
			}
			let current = ids[0] ?? '';
			for (const el of headings) {
				if (el.getBoundingClientRect().top <= 100) current = el.id;
				else break;
			}
			setActive(current);
		};

		io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) visible.add(entry.target.id);
					else visible.delete(entry.target.id);
				}
				update();
			},
			{ rootMargin: '0px 0px -70% 0px', threshold: 0 },
		);

		for (const el of headings) io.observe(el);
		window.addEventListener('scroll', update, { passive: true });
		update();
	}

	document.addEventListener('astro:page-load', setupToc);
</script>

<style>
	.toc {
		position: fixed;
		bottom: 1.25rem;
		right: 1.25rem;
		z-index: 20;
		width: 14rem;
		max-width: calc(100vw - 2.5rem);
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.toc-open {
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--muted);
		font: inherit;
		padding: 0.25rem 0.6rem;
		cursor: pointer;
		float: right;
	}
	.toc-open:hover {
		color: var(--fg);
		border-color: var(--fg);
	}
	.toc[data-open='true'] .toc-open {
		display: none;
	}

	.toc-panel {
		display: none;
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.5rem 0.75rem 0.7rem;
		max-height: calc(100vh - 6.5rem);
		overflow-y: auto;
	}
	.toc[data-open='true'] .toc-panel {
		display: block;
	}

	.toc-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.4rem;
	}
	.toc-title {
		color: var(--muted);
	}
	.toc-close {
		background: none;
		border: none;
		color: var(--muted);
		font: inherit;
		font-size: 1.1rem;
		line-height: 1;
		padding: 0 0.15rem;
		cursor: pointer;
	}
	.toc-close:hover {
		color: var(--fg);
	}

	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc-list li {
		padding: 0.18rem 0;
	}
	.toc-list li a {
		text-decoration: none;
		color: var(--muted);
		display: block;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.toc-list li a:hover {
		color: var(--fg);
	}
	.toc-list li.active > a {
		color: var(--fg);
	}
	.toc-h3 {
		padding-left: 0.8rem;
	}

	@media (min-width: 1700px) {
		.toc {
			position: static;
			width: auto;
			max-width: none;
			padding: 0 1.5rem 0 2rem;
		}
		.toc-inner {
			position: sticky;
			top: 4.5rem;
			max-width: 15rem;
		}
		.toc-open {
			float: none;
		}
		.toc-panel {
			background: none;
			border: none;
			border-left: 2px solid var(--border);
			padding: 0 0 0 0.75rem;
		}
	}
</style>
