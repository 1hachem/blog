<svg
	class="tacking-diagram"
	viewBox="0 0 760 400"
	xmlns="http://www.w3.org/2000/svg"
	fill="none"
	role="img"
	aria-label="Two views of a sailboat going upwind. Left: the course zigzags at 45 degrees to each side of the wind, gaining ground upwind on every leg. Right: the wind flowing over the angled sail pulls it sideways and slightly forward, the keel blocks the sideways part, and the boat moves forward."
>
	<style>
		svg.tacking-diagram {
			color: var(--fg);
		}
		svg.tacking-diagram .s {
			stroke: currentColor;
			stroke-width: 1.6;
		}
		svg.tacking-diagram .thick {
			stroke: currentColor;
			stroke-width: 4;
			stroke-linecap: round;
		}
		svg.tacking-diagram .accent {
			stroke: var(--accent);
			stroke-width: 2;
		}
		svg.tacking-diagram .dash {
			stroke: currentColor;
			stroke-width: 1.2;
			stroke-dasharray: 4 4;
			opacity: 0.55;
		}
		svg.tacking-diagram .wind {
			stroke: currentColor;
			stroke-width: 1.2;
			opacity: 0.5;
		}
		svg.tacking-diagram .t {
			fill: currentColor;
			font-family:
				'JetBrains Mono', 'JetBrainsMono Nerd Font', ui-monospace, 'Cascadia Code',
				'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
		}
		svg.tacking-diagram .ta {
			fill: var(--accent);
		}
		svg.tacking-diagram .ttl {
			font-size: 13px;
		}
		svg.tacking-diagram .cap {
			font-size: 12px;
			opacity: 0.72;
		}
		svg.tacking-diagram .sm {
			font-size: 11px;
			opacity: 0.72;
		}
	</style>
	<defs>
		<marker
			id="ah-tack"
			viewBox="0 0 10 10"
			refX="9"
			refY="5"
			markerWidth="7"
			markerHeight="7"
			orient="auto-start-reverse"
		>
			<path d="M0 0L10 5L0 10z" fill="currentColor"></path>
		</marker>
		<marker
			id="ah-tack-accent"
			viewBox="0 0 10 10"
			refX="9"
			refY="5"
			markerWidth="7"
			markerHeight="7"
			orient="auto-start-reverse"
		>
			<path d="M0 0L10 5L0 10z" fill="var(--accent)"></path>
		</marker>
	</defs>

	<text x="190" y="24" text-anchor="middle" class="t ttl">the course, from above</text>
	<text x="50" y="60" class="t sm">wind</text>
	<line class="wind" x1="40" y1="40" x2="40" y2="110" marker-end="url(#ah-tack)"></line>
	<line class="wind" x1="340" y1="40" x2="340" y2="110" marker-end="url(#ah-tack)"></line>

	<circle cx="200" cy="72" r="6" class="s"></circle>
	<text x="186" y="76" text-anchor="end" class="t sm">upwind mark</text>

	<line class="dash" x1="200" y1="350" x2="200" y2="290"></line>
	<line class="dash" x1="200" y1="350" x2="152" y2="302"></line>
	<line class="dash" x1="200" y1="350" x2="248" y2="302"></line>
	<text x="254" y="316" class="t sm">no-go zone</text>

	<path
		class="accent"
		d="M200 350L120 270L260 130L214 84"
		stroke-linejoin="round"
		marker-end="url(#ah-tack-accent)"></path>
	<text x="150" y="324" text-anchor="end" class="t sm ta">45°</text>
	<text x="214" y="214" class="t sm ta">45°</text>
	<circle cx="120" cy="270" r="3" fill="currentColor"></circle>
	<circle cx="260" cy="130" r="3" fill="currentColor"></circle>
	<text x="104" y="262" text-anchor="end" class="t sm">tack</text>
	<text x="276" y="134" class="t sm">tack</text>
	<text x="200" y="370" text-anchor="middle" class="t sm">start</text>

	<line class="dash" x1="380" y1="20" x2="380" y2="360"></line>

	<text x="570" y="24" text-anchor="middle" class="t ttl">one leg, up close</text>
	<text x="440" y="66" class="t sm">wind</text>
	<line class="wind" x1="410" y1="76" x2="480" y2="146" marker-end="url(#ah-tack)"></line>
	<line class="wind" x1="416" y1="140" x2="470" y2="194" marker-end="url(#ah-tack)"></line>

	<path class="s" d="M570 140C592 170 594 270 586 310L554 310C546 270 548 170 570 140Z"></path>
	<line class="thick" x1="570" y1="240" x2="570" y2="290"></line>
	<path class="thick" d="M570 196Q592 226 598 276"></path>
	<circle cx="570" cy="196" r="3.5" fill="currentColor"></circle>

	<line class="accent" x1="590" y1="236" x2="710" y2="191" marker-end="url(#ah-tack-accent)"></line>
	<text x="716" y="180" text-anchor="end" class="t sm ta">sail pulls</text>
	<line class="dash" x1="590" y1="236" x2="706" y2="236" marker-end="url(#ah-tack)"></line>
	<text x="652" y="254" text-anchor="middle" class="t sm">sideways</text>
	<line class="s" x1="552" y1="276" x2="468" y2="276" marker-end="url(#ah-tack)"></line>
	<text x="508" y="296" text-anchor="middle" class="t sm">keel resists</text>
	<line class="accent" x1="570" y1="130" x2="570" y2="72" marker-end="url(#ah-tack-accent)"></line>
	<text x="582" y="92" class="t sm ta">forward</text>

	<text x="190" y="392" text-anchor="middle" class="t cap">never straight in, zigzag</text>
	<text x="570" y="392" text-anchor="middle" class="t cap">forward is all that's left</text>
</svg>
