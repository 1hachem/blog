---
interface Link {
	href: string;
	label: string;
}
interface Props {
	links: Link[];
}
const { links } = Astro.props;
---

<nav class="page-nav" aria-label="page navigation">
	{
		links.map((link, i) => (
			<>
				{i > 0 && <span class="sep"> | </span>}
				<a href={link.href} data-astro-prefetch>
					{link.label}
				</a>
			</>
		))
	}
</nav>

<style>
	.page-nav {
		margin-bottom: 1.75rem;
		font-size: 0.9rem;
	}
	.page-nav a {
		color: var(--muted);
		text-decoration: none;
	}
	.page-nav a:hover {
		color: var(--fg);
		text-decoration: underline;
	}
	.sep {
		color: var(--border);
	}
</style>
