---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	related?: CollectionEntry<'blog'>[];
	headings?: MarkdownHeading[];
};

const {
	title, description, pubDate, updatedDate,
	keywords, canonicalURL, noindex, ogTitle, ogDescription, ogImage, author,
	category, related = [], headings = [],
} = Astro.props;

const categorySlug = category?.toLowerCase().replace(/\s+/g, '-');
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			keywords={keywords}
			canonicalURL={canonicalURL}
			noindex={noindex}
			ogTitle={ogTitle}
			ogDescription={ogDescription}
			ogImage={ogImage}
			author={author}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && <span class="updated"> · updated <FormattedDate date={updatedDate} /></span>}
						{category && (
							<span> · <a href={`/category/${categorySlug}`} data-astro-prefetch>{category}</a></span>
						)}
					</p>
					<h1>{title}</h1>
					<hr />
				</header>

				<div class="post-body">
					<div class="prose">
						<slot />
					</div>
					<TableOfContents headings={headings} />
				</div>

				{related.length > 0 && (
					<aside class="related">
						<hr />
						<p class="related-heading">more in <a href={`/category/${categorySlug}`} data-astro-prefetch>{category}</a></p>
						<ul>
							{related.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`} data-astro-prefetch>{p.data.title}</a>
									<span class="date"><FormattedDate date={p.data.pubDate} /></span>
								</li>
							))}
						</ul>
					</aside>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 1rem;
	}
	.post-header h1 {
		margin-top: 0.25rem;
	}
	.post-meta {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0;
	}
	.updated {
		font-style: italic;
	}

	/* Wide: prose left, TOC right, both inside the normal content width */
	.post-body {
		display: grid;
		grid-template-columns: 1fr 13rem;
		gap: 0 2.5rem;
		align-items: start;
	}

	.prose {
		min-width: 0;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2rem;
	}

	/* TOC sticky within the post-body grid column */
	.post-body :global(.toc) {
		position: sticky;
		top: 3.5rem;
	}

	/* Mobile: single column, TOC below prose */
	@media (max-width: 700px) {
		.post-body {
			grid-template-columns: 1fr;
		}
		/* Move TOC before prose visually */
		.post-body :global(.toc) {
			order: -1;
			position: static;
			margin-bottom: 1.5rem;
		}
	}

	.related {
		margin-top: 3rem;
	}
	.related-heading {
		font-size: 0.85rem;
		color: var(--muted);
		margin-bottom: 0.5rem;
	}
	.related ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.related li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.3rem 0;
		border-bottom: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.related li:first-child {
		border-top: 1px solid var(--border);
	}
	.related li a {
		text-decoration: none;
	}
	.related li a:hover {
		text-decoration: underline;
	}
	.date {
		color: var(--muted);
		font-size: 0.85rem;
		flex-shrink: 0;
	}
</style>
