---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageNav from '../components/PageNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	related?: CollectionEntry<'blog'>[];
	headings?: MarkdownHeading[];
	readingTime?: string;
};

const {
	title, description, pubDate, updatedDate,
	keywords, canonicalURL, noindex, ogTitle, ogDescription, ogImage, author,
	category, tags = [], related = [], headings = [], readingTime,
} = Astro.props;

const categorySlug = category?.toLowerCase().replace(/\s+/g, '-');
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			keywords={keywords}
			canonicalURL={canonicalURL}
			noindex={noindex}
			ogTitle={ogTitle}
			ogDescription={ogDescription}
			ogImage={ogImage}
			author={author}
		/>
	</head>
	<body>
		<div class="topbar">
			<ThemeToggle />
		</div>
		<main>
			<article data-pagefind-body>
				<header class="post-header">
					<div data-pagefind-ignore>
						<PageNav links={[{ href: '/blog', label: '← blog' }, { href: '/', label: 'home' }]} />
					</div>
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && <span class="updated"> · updated <FormattedDate date={updatedDate} /></span>}
						{category && (
							<span> · <a href={`/category/${categorySlug}`} data-astro-prefetch>{category}</a></span>
						)}
						{readingTime && <span> · {readingTime}</span>}
					</p>
					<h1>{title}</h1>
					{tags.length > 0 && (
						<p class="post-tags">
							{tags.map((tag: string) => (
								<a href={`/tag/${tag}`} class="tag" data-astro-prefetch>#{tag}</a>
							))}
						</p>
					)}
				</header>

				<div class="post-body">
					<div class="prose">
						<slot />
					</div>
				</div>

				<TableOfContents headings={headings} />

				{related.length > 0 && (
					<aside class="related" data-pagefind-ignore>
						<p class="related-heading">more in <a href={`/category/${categorySlug}`} data-astro-prefetch>{category}</a></p>
						<ul>
							{related.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`} data-astro-prefetch>{p.data.title}</a>
									<span class="date"><FormattedDate date={p.data.pubDate} /></span>
								</li>
							))}
						</ul>
					</aside>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.topbar {
		position: fixed;
		top: 0.6rem;
		right: 0.9rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		z-index: 10;
	}
	/* Blog post widens the global main so the prose + TOC grid has room,
	   while keeping the side padding so content isn't flush to the edges */
	body:has(article) main {
		max-width: 1650px;
	}
</style>

<style>
	/* Content spans the wide middle column; the TOC lives in a
	   dedicated column out in the right margin */
	article {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 14rem;
		column-gap: 7rem;
		align-items: start;
	}
	.post-header {
		grid-column: 1;
		grid-row: 1;
	}
	.post-body {
		grid-column: 1;
		grid-row: 2;
	}
	.related {
		grid-column: 1;
		grid-row: 3;
	}

	.post-header {
		margin-bottom: 1rem;
	}
	.post-header h1 {
		margin-top: 0.25rem;
	}
	.post-meta {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0;
	}
	.post-tags {
		margin: 0.4rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.tag {
		font-size: 0.78rem;
		color: var(--muted);
		text-decoration: none;
	}
	.tag:hover {
		color: var(--fg);
	}
	.updated {
		font-style: italic;
	}

	.prose {
		min-width: 0;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2rem;
	}

	/* TOC out in the right margin, spanning the content rows, sticky */
	article :global(.toc) {
		grid-column: 2;
		/* start at the post body row, not the header, so it lines up
		   with the blog body */
		grid-row: 2;
		position: sticky;
		top: 3.5rem;
	}

	/* Mobile: single column, TOC above prose */
	@media (max-width: 700px) {
		article {
			grid-template-columns: 1fr;
		}
		article :global(.toc) {
			grid-column: 1;
			grid-row: auto;
			order: -1;
			position: static;
			margin-bottom: 1.5rem;
		}
	}

	.related {
		margin-top: 3rem;
	}
	.related-heading {
		font-size: 0.85rem;
		color: var(--muted);
		margin-bottom: 0.5rem;
	}
	.related ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.related li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.3rem 0;
		border-bottom: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.related li:first-child {
		border-top: 1px solid var(--border);
	}
	.related li a {
		text-decoration: none;
	}
	.related li a:hover {
		text-decoration: underline;
	}
	.date {
		color: var(--muted);
		font-size: 0.85rem;
		flex-shrink: 0;
	}
</style>
