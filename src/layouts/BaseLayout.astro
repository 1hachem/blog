---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';

interface NavLink {
	href: string;
	label: string;
}
interface Props {
	title: string;
	description: string;
	image?: string;
	navLinks?: NavLink[];
}

const { title, description, image, navLinks } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<main>
			{navLinks && <PageNav links={navLinks} />}
			<slot />
		</main>
		<Footer />
	</body>
</html>
