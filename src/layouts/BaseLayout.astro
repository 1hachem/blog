---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface NavLink {
	href: string;
	label: string;
}
interface Props {
	title: string;
	description: string;
	navLinks?: NavLink[];
}

const { title, description, navLinks } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<div class="topbar">
			<ThemeToggle />
		</div>
		<main>
			{navLinks && navLinks.length > 0 && <PageNav links={navLinks} />}
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.topbar {
		position: absolute;
		top: 0.6rem;
		right: 0.9rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		z-index: 10;
	}
</style>
