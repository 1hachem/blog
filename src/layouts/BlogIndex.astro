---
import type { CollectionEntry } from 'astro:content';
import CategoryFilter from '../components/CategoryFilter.astro';
import RandomQuote from '../components/RandomQuote.astro';
import TimelinePostList from '../components/TimelinePostList.astro';
import BaseLayout from './BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getQuotes } from '../lib/categories';

interface Category {
	label: string;
	description: string;
}

interface Props {
	posts: CollectionEntry<'blog'>[];
	currentPage: number;
	totalPages: number;
	categories: Category[];
	active?: string; // current category slug, undefined = all
	title: string;
	description?: string;
}

const { posts, currentPage, totalPages, categories, active, title, description } = Astro.props;

const baseURL = active ? `/blog/${active}` : '/blog';
const quotes = getQuotes(active);
const navLinks = [
	{ href: '/', label: '← home' },
	{ href: '/about', label: 'about' },
];
---

<BaseLayout
	title={`${title} · ${SITE_TITLE}`}
	description={description ?? SITE_DESCRIPTION}
	navLinks={navLinks}
>
	<RandomQuote quotes={quotes} />
	<CategoryFilter categories={categories} active={active} />
	<TimelinePostList
		posts={posts}
		currentPage={currentPage}
		totalPages={totalPages}
		baseURL={baseURL}
	/>
</BaseLayout>
