---
import Search from 'astro-pagefind/components/Search.astro';
---

<div class="search">
	<Search
		id="site-search"
		className="pagefind-ui"
		uiOptions={{ showImages: false, excerptLength: 15, resetStyles: false }}
	/>
</div>

<style is:global>
	/* Compact, low-profile search that lives in the top bar next to the toggle */
	.search {
		width: 12rem;
	}
	.search .pagefind-ui {
		--pagefind-ui-primary: var(--fg);
		--pagefind-ui-text: var(--fg);
		--pagefind-ui-background: var(--bg);
		--pagefind-ui-border: transparent;
		--pagefind-ui-tag: var(--bg);
		--pagefind-ui-border-width: 0px;
		--pagefind-ui-border-radius: 0px;
		--pagefind-ui-font: var(--font-mono);
	}
	.search .pagefind-ui__form::before {
		opacity: 0.45;
		width: 0.85rem;
		height: 0.85rem;
		top: 0.35rem;
	}
	.search .pagefind-ui__search-input {
		font-size: 0.8rem;
		padding: 0.15rem 0.5rem 0.15rem 1.6rem;
		background: var(--bg);
		color: var(--fg);
		border: none;
		border-bottom: 1px solid var(--border);
	}
	.search .pagefind-ui__search-input:focus {
		border-bottom-color: var(--fg);
		outline: none;
	}
	.search .pagefind-ui__search-clear {
		background: transparent;
		color: var(--muted);
		font-size: 0.75rem;
	}
	/* Results drop below the bar, over the app background */
	.search .pagefind-ui__results-area {
		position: absolute;
		right: 0;
		width: 22rem;
		max-width: 80vw;
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.5rem 0.75rem;
		max-height: 70vh;
		overflow-y: auto;
		z-index: 20;
	}
	.search .pagefind-ui__result {
		border-top: 1px solid var(--border);
	}
	.search .pagefind-ui__result-title a {
		color: var(--fg);
	}
	.search .pagefind-ui__result-excerpt {
		color: var(--muted);
	}
	.search mark {
		background: transparent;
		color: var(--accent);
		font-weight: 700;
	}
</style>
