---
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
---

<div class="search">
	<PagefindConfig />
	<pagefind-modal-trigger placeholder="Search"></pagefind-modal-trigger>
	<pagefind-modal>
		<pagefind-modal-header>
			<pagefind-input placeholder="Search posts…" autofocus></pagefind-input>
		</pagefind-modal-header>
		<pagefind-modal-body>
			<div class="search-empty search-empty-initial">
				<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<circle cx="11" cy="11" r="7" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" />
				</svg>
				<p>Search posts by title, category, or content.</p>
			</div>
			<div class="search-empty search-empty-none">
				<p>No results found.</p>
			</div>
			<pagefind-summary></pagefind-summary>
			<pagefind-results></pagefind-results>
		</pagefind-modal-body>
		<pagefind-modal-footer>
			<pagefind-keyboard-hints></pagefind-keyboard-hints>
		</pagefind-modal-footer>
	</pagefind-modal>
</div>

<style is:global>
	/* Map Pagefind's component-ui tokens onto the site's design tokens */
	.search {
		--pf-font: var(--font-mono);
		--pf-background: var(--bg);
		--pf-text: var(--fg);
		--pf-text-muted: var(--muted);
		--pf-text-secondary: var(--muted);
		--pf-border: var(--border);
		--pf-border-focus: var(--fg);
		--pf-border-radius: 0px;
		--pf-hover: transparent;
		--pf-mark: var(--accent);
		--pf-modal-max-width: 34rem;
		--pf-modal-top: 12vh;
		--pf-shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.25);
		margin-bottom: 1rem;
	}

	/* Minimal trigger — matches the category-filter chips */
	.search pagefind-modal-trigger .pf-trigger-btn {
		width: auto;
		height: auto;
		gap: 0.4rem;
		padding: 0.1rem 0.5rem;
		font-size: 0.85rem;
		background: transparent;
		border: 1px solid var(--border);
		color: var(--muted);
	}
	.search pagefind-modal-trigger .pf-trigger-btn:hover {
		color: var(--fg);
		border-color: var(--fg);
		box-shadow: none;
	}
	.search pagefind-modal-trigger .pf-trigger-icon {
		opacity: 0.7;
	}
	.search pagefind-modal-trigger .pf-trigger-key {
		background: transparent;
		border: none;
		font-size: 0.7rem;
		color: var(--muted);
	}

	/* Matched-term highlight uses the site link color */
	.pf-result-excerpt mark,
	.pf-heading-excerpt mark,
	.pf-searchbox-result-excerpt mark {
		color: var(--accent) !important;
		background: transparent !important;
	}

	/* Empty states in the modal body */
	.search-empty {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		text-align: center;
		padding: 2.5rem 1rem;
		color: var(--muted);
	}
	.search-empty svg {
		opacity: 0.4;
	}
	.search-empty p {
		margin: 0;
		font-size: 0.9rem;
	}
	.search-empty-none p {
		color: var(--fg);
	}

	/* Nothing typed yet → prompt, and hide the results/summary chrome */
	.pf-modal:has(.pf-input:placeholder-shown) .search-empty-initial {
		display: flex;
	}
	.pf-modal:has(.pf-input:placeholder-shown) pagefind-summary,
	.pf-modal:has(.pf-input:placeholder-shown) pagefind-results {
		display: none;
	}

	/* Term typed but no matches (and not mid-search) → no-results state */
	.pf-modal:has(.pf-input:not(:placeholder-shown)):has(.pf-results:empty:not([aria-busy="true"])) .search-empty-none {
		display: flex;
	}
	.pf-modal:has(.pf-input:not(:placeholder-shown)):has(.pf-results:empty:not([aria-busy="true"])) pagefind-summary {
		display: none;
	}
</style>

<script>
	const INITIAL = [
		'Type something. I promise I read the docs on this.',
		"Search is O(1) on an empty query. You're welcome.",
		'grep, but make it aesthetic.',
		'Nothing to see here. Literally. Start typing.',
		'Ask me anything. Well — anything I wrote about.',
		"Go on, type. The posts won't bite.",
		'What are we looking for today, detective?',
		'The search bar is lonely. Give it purpose.',
		'Fun fact: this box works better with words in it.',
		"Schrödinger's results: they exist and don't until you type.",
	];

	const NO_RESULTS = [
		'404: brilliance not found. Try fewer big words.',
		"No matches. Even I'm surprised — I wrote a lot of nonsense.",
		'0 results. Have you tried turning the query off and on again?',
		"Nothing. Either you're too specific or I'm too lazy a writer.",
		'Nope. That topic lives in the drafts folder of my mind.',
		"Couldn't find it. Maybe I haven't had that thought yet.",
		'No results, but I admire your curiosity.',
		'Swing and a miss. Try another word?',
		'No results. Possibly because I never finish anything.',
		'Searched the whole blog. Twice. Made you a coffee. Still nothing.',
		'The posts you seek are in another castle. 🍄',
	];

	const pick = (arr: string[]) => arr[Math.floor(Math.random() * arr.length)];

	function initSearchCopy() {
		const root = document.querySelector<HTMLElement>('.search');
		if (!root || root.dataset.copyBound) return;
		root.dataset.copyBound = 'true';

		const setInitial = () => {
			const el = root.querySelector<HTMLElement>('.search-empty-initial p');
			if (el) el.textContent = pick(INITIAL);
		};
		const setNoResults = () => {
			const el = root.querySelector<HTMLElement>('.search-empty-none p');
			if (el) el.textContent = pick(NO_RESULTS);
		};

		// Re-roll the initial prompt before the palette paints, so it doesn't
		// flash the previous message. Capture phase runs ahead of Pagefind's
		// own open handler, and no setTimeout means the swap lands pre-paint.
		root.querySelector('pagefind-modal-trigger')
			?.addEventListener('click', setInitial, true);
		document.addEventListener('keydown', (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') setInitial();
		}, true);

		// Re-roll the no-results line each time we enter that state
		let wasNoResults = false;
		const check = () => {
			const input = root.querySelector<HTMLInputElement>('.pf-input');
			const results = root.querySelector<HTMLElement>('.pf-results');
			if (!input || !results) return;
			const typed = input.value.trim().length > 0;
			const busy = results.getAttribute('aria-busy') === 'true';
			const noRes = typed && !busy && results.children.length === 0;
			if (noRes && !wasNoResults) setNoResults();
			wasNoResults = noRes;
		};

		const observer = new MutationObserver(check);
		// The modal DOM is built asynchronously when component-ui upgrades
		let tries = 0;
		const wait = setInterval(() => {
			const body = root.querySelector('.pf-modal-body');
			if (body) {
				observer.observe(body, {
					childList: true,
					subtree: true,
					attributes: true,
					attributeFilter: ['aria-busy'],
				});
				clearInterval(wait);
			} else if (++tries > 30) {
				clearInterval(wait);
			}
		}, 100);

		setInitial();
	}

	initSearchCopy();
	document.addEventListener('astro:after-swap', initSearchCopy);
</script>
