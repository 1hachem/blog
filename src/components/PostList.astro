---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	currentPage: number;
	totalPages: number;
	// root URL for page 1 of this listing (e.g. "/" or "/category/tech")
	baseURL: string;
}

const { posts, currentPage, totalPages, baseURL } = Astro.props;

const THREE_MONTHS = 1000 * 60 * 60 * 24 * 90;
const now = Date.now();

function isRecent(date: Date) {
	return now - date.valueOf() < THREE_MONTHS;
}

// Page 1 always lives at baseURL; page N at baseURL/page/N
function pageURL(n: number) {
	if (n <= 1) return baseURL;
	const prefix = baseURL === '/' ? '' : baseURL;
	return `${prefix}/page/${n}`;
}
---

<ul class="post-list">
	{posts.map((post) => (
		<li>
			<div class="post-meta">
				<a href={`/blog/${post.id}/`} data-astro-prefetch>{post.data.title}</a>
				{isRecent(post.data.pubDate) && <span class="badge-recent">new</span>}
			</div>
			<span class="date"><FormattedDate date={post.data.pubDate} /></span>
		</li>
	))}
</ul>

{totalPages > 1 && (
	<nav class="pagination">
		{currentPage > 1
			? <a href={pageURL(currentPage - 1)} data-astro-prefetch>← prev</a>
			: <span class="disabled">← prev</span>
		}
		<span class="page-count">{currentPage} / {totalPages}</span>
		{currentPage < totalPages
			? <a href={pageURL(currentPage + 1)} data-astro-prefetch>next →</a>
			: <span class="disabled">next →</span>
		}
	</nav>
)}

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
	}
	.post-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--border);
	}
	.post-list li:first-child {
		border-top: 1px solid var(--border);
	}
	.post-meta {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		min-width: 0;
	}
	.post-meta > a {
		text-decoration: none;
	}
	.post-meta > a:hover {
		text-decoration: underline;
	}
	.badge-recent {
		font-size: 0.7rem;
		border: 1px solid var(--fg);
		padding: 0 0.3rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		flex-shrink: 0;
	}
	.date {
		color: var(--muted);
		font-size: 0.85rem;
		flex-shrink: 0;
	}
	.pagination {
		display: flex;
		gap: 1rem;
		align-items: center;
		font-size: 0.9rem;
	}
	.page-count {
		color: var(--muted);
	}
	.disabled {
		color: var(--border);
	}
	@media (max-width: 500px) {
		.post-list li {
			flex-direction: column;
			gap: 0.15rem;
		}
		.date { font-size: 0.75rem; }
	}
</style>
