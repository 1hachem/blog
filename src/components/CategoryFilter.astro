---
import Search from './Search.astro';

interface Category {
	label: string;
	description: string;
}

interface Props {
	categories: Category[];
	active?: string; // current category slug, undefined = all
}

const { categories, active } = Astro.props;

function slug(cat: string) {
	return cat.toLowerCase().replace(/\s+/g, '-');
}
---

<div class="filter-row">
	<nav class="filter">
		<a href="/blog" class:list={[{ active: !active }]} data-astro-prefetch>all</a>
		{categories.map((cat) => (
			<a
				href={`/category/${slug(cat.label)}`}
				class:list={[{ active: active === slug(cat.label) }, 'has-tooltip']}
				data-astro-prefetch
			>
				{cat.label}
				<span class="tooltip"><span class="tooltip-text">{cat.description}</span></span>
			</a>
		))}
	</nav>
	<Search />
</div>

<style>
	.filter-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin-bottom: 1.5rem;
	}
	/* Search carries its own bottom margin; neutralize it inside the row */
	.filter-row :global(.search) {
		margin-bottom: 0;
	}
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.filter a {
		font-size: 0.85rem;
		text-decoration: none;
		color: var(--muted);
		border: 1px solid var(--border);
		padding: 0.1rem 0.5rem;
		position: relative;
	}
	.filter a:hover,
	.filter a.active {
		color: var(--fg);
		border-color: var(--fg);
	}
</style>

<script>
	function initTooltips() {
		let timer: ReturnType<typeof setTimeout> | null = null;

		document.querySelectorAll<HTMLAnchorElement>('.filter .has-tooltip').forEach((link) => {
			const tip = link.querySelector<HTMLElement>('.tooltip');
			if (!tip) return;

			link.addEventListener('mouseenter', (e) => {
				const me = e as MouseEvent;
				timer = setTimeout(() => {
					tip.style.left = me.clientX + 12 + 'px';
					tip.style.top = me.clientY - 28 + 'px';
					tip.classList.add('visible');
				}, 700);
			});

			link.addEventListener('mousemove', (e) => {
				const me = e as MouseEvent;
				tip.style.left = me.clientX + 12 + 'px';
				tip.style.top = me.clientY - 28 + 'px';
			});

			link.addEventListener('mouseleave', () => {
				if (timer) { clearTimeout(timer); timer = null; }
				tip.classList.remove('visible');
			});
		});
	}

	// Runs on first load and after every ClientRouter swap.
	document.addEventListener('astro:page-load', initTooltips);
</script>
