---
import 'devicon/devicon.min.css';
import { TECH, history, CATEGORY_LABEL, type Commit, type Category } from '../data/graph';
import { assignLanes, buildEdges, tiltOf, shiftOf, yearMarks } from '../lib/graph-layout';
import { faviconUrl } from '../lib/favicon';

// chronological order, parents before children — the lane algorithm relies on it
const commits: Commit[] = [...history].sort((a, b) => a.t - b.t);

// Every branch gets its own label + colour; commits on `main` take a chip derived
// from their kind, overridable per-commit.
type Chip = { label: string; color: string };
const BRANCH_META: Record<string, Chip> = {
	streets: { label: 'free roam', color: '#e5722a' },
	wild: { label: 'wandering', color: '#96692e' },
	contests: { label: 'achievement', color: '#d99e00' },
	freelance: { label: 'freelance', color: '#2f7ee5' },
	research: { label: 'research', color: '#0891b2' },
	ventures: { label: 'world map', color: '#10a5a5' },
	oss: { label: 'crafting', color: '#9333ea' },
	lisptc: { label: 'crafting', color: '#9333ea' },
	bigmama: { label: 'campaign', color: '#5b5bd6' },
};
const TYPE_CHIP: Partial<Record<Commit['type'], Chip>> = {
	accident: { label: 'character development', color: '#e5484d' },
	education: { label: '+1 XP', color: '#8e4ec6' },
	travel: { label: 'world map', color: '#10a5a5' },
};
const CHIP_OVERRIDE: Record<string, Chip> = {
	hackathon: { label: '+1 XP', color: '#8e4ec6' },
	dad: { label: '+∞ love', color: '#db2777' },
	tedx: { label: 'on stage', color: '#E62B1E' },
};
const chipFor = (c: Commit): Chip | undefined =>
	CHIP_OVERRIDE[c.id] ?? (c.branch !== 'main' ? BRANCH_META[c.branch] : TYPE_CHIP[c.type]);

const { laneOf, minLane, laneCount } = assignLanes(commits);

// newest -> oldest (top of page = latest); `card` overrides the default side
const rows = [...commits].reverse().map((c) => ({
	...c,
	lane: laneOf[c.branch] - minLane,
	side: (c.card ?? (laneOf[c.branch] < 0 ? 'left' : 'right')) as 'left' | 'right',
	chip: chipFor(c),
	photoLabel: c.photos?.length
		? `${c.photos.length} photo${c.photos.length > 1 ? 's' : ''}`
		: undefined,
}));

const EDGES = buildEdges(commits, (branch) => BRANCH_META[branch]?.color ?? null);

const LEGEND = (Object.keys(CATEGORY_LABEL) as Category[]).map((type) => ({
	type,
	label: CATEGORY_LABEL[type],
}));

interface Props {
	limit?: number; // render only the newest N commits (a teaser)
	showLegend?: boolean; // show the colour key
	preview?: boolean; // non-interactive teaser mode
}
const { limit, showLegend = false, preview = false } = Astro.props;
const visibleRows = typeof limit === 'number' ? rows.slice(0, limit) : rows;
const yearMark = yearMarks(visibleRows);
---

{
	(showLegend || !preview) && (
		<div class="graph-head">
			{showLegend && (
				<ul class="legend" aria-label="colour key">
					{LEGEND.map((l) => (
						<li class="legend-item">
							<span class={`dot ${l.type}`} />
							{l.label}
						</li>
					))}
				</ul>
			)}
			{!preview && (
				<div class="graph-buttons">
					<button type="button" class="flip-toggle" aria-pressed="false">
						<span class="flip-label">start from birth</span>
					</button>
				</div>
			)}
		</div>
	)
}

<div class:list={['gitgraph', { preview }]} style={`--lanes:${laneCount}`}>
	<svg class="graph-edges" aria-hidden="true"></svg>
	<script
		type="application/json"
		class="graph-edges-data"
		set:html={JSON.stringify(EDGES)}
		is:inline
	/>
	{
		visibleRows.map((c, i) => (
			<>
				{yearMark[i] && (
					<div class="year-sep" aria-hidden="true">
						<span class="year-sep-label">{yearMark[i]}</span>
					</div>
				)}
				<div
					class={[
						'commit',
						c.type,
						c.branch === 'main' ? 'on-main' : 'on-branch',
						`side-${c.side}`,
						c.root ? 'is-root' : '',
						c.hidden ? 'is-junction' : '',
					].join(' ')}
					data-type={c.type}
					data-id={c.id}
					data-branch={c.branch}
				>
					<div class="graph-cell">
						<span class="node" data-node data-id={c.id} style={`--lane:${c.lane}`} />
					</div>
					<div class="card">
						{!c.hidden && (
							<h3 class="title">
								{c.year && <span class="yr">{c.year}</span>}
								{c.title}
								{c.chip && (
									<span class="chip" style={`--chip:${c.chip.color}`}>
										{c.chip.label}
									</span>
								)}
								{c.photos && c.photos.length > 0 && (
									<button
										type="button"
										class="photo-badge"
										title={c.photoLabel}
										aria-label={`View ${c.photoLabel}`}
									>
										{c.photos.length}
										<svg class="photo-ico" viewBox="0 0 24 24" aria-hidden="true">
											<rect x="3" y="5" width="18" height="14" rx="2" />
											<circle cx="8.5" cy="10" r="1.6" />
											<path d="M21 16l-5-5-4 4-2-2-4 4" />
										</svg>
									</button>
								)}
							</h3>
						)}
						{!c.hidden && c.desc && <p class="desc">{c.desc}</p>}
						{c.links && (
							<p class="links">
								{c.links.map((lk) => {
									const yt = lk.href.includes('youtube.com') || lk.href.includes('youtu.be');
									// External (non-YouTube) links get the destination site's favicon,
									// matching the blog's rehype-link-favicons plugin.
									const favicon = !yt ? faviconUrl(lk.href) : undefined;
									return (
										<a
											href={lk.href}
											class={yt ? 'yt-link' : favicon ? 'fav-link' : undefined}
											target={lk.href.startsWith('http') ? '_blank' : undefined}
											rel={lk.href.startsWith('http') ? 'noopener' : undefined}
										>
											{yt && (
												<svg class="yt-ico" viewBox="0 0 24 24" aria-hidden="true">
													<path
														fill="#FF0000"
														d="M23 7.5a3 3 0 00-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 001 7.5 31 31 0 00.5 12 31 31 0 001 16.5a3 3 0 002.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5A3 3 0 0023 16.5 31 31 0 0023.5 12 31 31 0 0023 7.5z"
													/>
													<path fill="#fff" d="M9.75 15.5v-7l6 3.5z" />
												</svg>
											)}
											{favicon && (
												<img
													class="link-favicon"
													src={favicon}
													alt=""
													aria-hidden="true"
													loading="lazy"
													width="16"
													height="16"
												/>
											)}
											{yt ? (
												<span class="yt-label" title={lk.label}>
													{lk.label}
												</span>
											) : (
												lk.label
											)}
										</a>
									);
								})}
							</p>
						)}
						{!c.hidden && c.tech && (
							<div class="badges">
								{c.tech.map((k) => {
									const t = TECH[k];
									return (
										<span
											class={`badge ${t.dark ? 'badge-dark' : 'badge-light'}`}
											style={`background:${t.bg}`}
										>
											{t.icon && <i class={`logo ${t.icon}`} aria-hidden="true" />}
											{t.label}
										</span>
									);
								})}
							</div>
						)}
					</div>
					{c.photos && c.photos.length > 0 && !c.hidden && (
						<div class="photos" data-count={c.photos.length}>
							{c.photos.map((src, i) => (
								<figure
									class="photo"
									style={`--tilt:${tiltOf(c.id + i)}deg; --dx:${shiftOf(c.id + i)}px; --i:${i}`}
								>
									<img src={src} alt="" loading="lazy" decoding="async" />
								</figure>
							))}
						</div>
					)}
					{c.tip && !c.hidden && <p class="tip-note" data-tip={c.tip} aria-hidden="true" />}
				</div>
			</>
		))
	}
</div>

<style is:global>
	/* the full graph breaks out of the default reading column; the preview does not */
	main:has(.gitgraph:not(.preview)) {
		max-width: 56rem;
	}
	/* lock background scroll while the photo lightbox is open */
	body.lightbox-open {
		overflow: hidden;
	}
</style>

<style>
	/* legend (static colour key) ------------------------------------------- */
	.graph-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		flex-wrap: wrap;
		margin: 1.25rem 0 1.75rem;
	}
	.legend {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		display: inline-block;
		flex-shrink: 0;
	}
	.dot.main {
		background: var(--c-main);
	}
	.dot.education {
		background: var(--c-education);
	}
	.dot.accident {
		background: var(--c-accident);
	}
	.dot.travel {
		background: var(--c-travel);
	}
	.dot.side {
		background: var(--c-side);
	}
	.dot.life {
		background: var(--c-life);
	}

	/* git graph ------------------------------------------------------------- */
	.gitgraph {
		position: relative;
		margin: 0 0 2rem;
		--lane-w: 1.35rem;
		--node-y: 1rem;
		--gutter: calc(var(--lanes) * var(--lane-w));
	}
	.gitgraph.preview {
		pointer-events: none;
		margin: 0;
	}
	/* birth-first view: reverse the vertical stack (edges redraw from live positions) */
	.gitgraph.flipped {
		display: flex;
		flex-direction: column-reverse;
	}

	.graph-buttons {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
		flex-shrink: 0;
	}
	.flip-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		flex-shrink: 0;
		padding: 0.2rem 0.55rem;
		font: inherit;
		font-size: 0.72rem;
		line-height: 1.2;
		color: var(--muted);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 999px;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.flip-toggle::before {
		content: '⇅';
		font-size: 0.9em;
		line-height: 1;
	}
	.flip-toggle:hover {
		color: var(--c-main);
		border-color: var(--c-main);
	}
	.flip-toggle[aria-pressed='true'] {
		color: var(--c-main);
		border-color: var(--c-main);
	}
	.graph-edges {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		overflow: visible;
		z-index: 0;
	}
	.graph-edges :global(path) {
		fill: none;
		stroke: var(--border);
		stroke-width: 2;
		transition:
			opacity 0.15s ease,
			stroke-width 0.15s ease;
	}
	/* hovering a card dims the graph and lights up that commit's branch */
	.gitgraph.graph-active .graph-edges :global(path) {
		opacity: 0.2;
	}
	.gitgraph.graph-active .graph-edges :global(path.hl) {
		opacity: 1;
		stroke-width: 3.5;
	}

	/* dim every commit slightly while hovering, keeping the hovered one full */
	.commit {
		transition: opacity 0.15s ease;
	}
	.gitgraph.graph-active .commit {
		opacity: 0.55;
	}
	.gitgraph.graph-active .commit:has(.card:hover),
	.gitgraph.graph-active .commit.active-mobile {
		opacity: 1;
	}

	/* full-width dotted rule between years, year label pinned to the far left */
	.year-sep {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0.6rem -3.5rem 1.1rem;
	}
	.year-sep-label {
		flex-shrink: 0;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--muted);
		opacity: 0.65;
	}
	.year-sep::after {
		content: '';
		flex: 1;
		height: 1px;
		/* dashed rule with wide gaps: 6px dash, 8px gap */
		background: repeating-linear-gradient(
			to right,
			color-mix(in srgb, var(--border) 60%, transparent) 0 6px,
			transparent 6px 14px
		);
	}

	.commit {
		display: grid;
		grid-template-columns: 1fr var(--gutter) 1fr;
		align-items: start;
		position: relative;
	}

	.graph-cell {
		grid-column: 2;
		position: relative;
	}
	.card {
		grid-column: 3;
		min-width: 0;
		padding-bottom: 1.7rem;
		position: relative;
		z-index: 1;
	}
	.commit.side-left .card {
		grid-column: 1;
		text-align: right;
	}
	.commit.side-left .title,
	.commit.side-left .links,
	.commit.side-left .badges {
		justify-content: flex-end;
	}
	.node {
		position: absolute;
		left: calc(var(--lane) * var(--lane-w) + var(--lane-w) / 2);
		top: var(--node-y);
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		background: var(--bg);
		box-shadow: 0 0 0 3px var(--bg);
		z-index: 2;
		transition: transform 0.15s ease;
	}
	.node.hl {
		transform: translate(-50%, -50%) scale(1.35);
		z-index: 3;
	}
	.commit.main .node {
		border: 2px solid var(--c-main);
	}
	.commit.education .node {
		border: 2px solid var(--c-education);
	}
	.commit.accident .node {
		border: 2px solid var(--c-accident);
	}
	.commit.travel .node {
		border: 2px solid var(--c-travel);
	}
	.commit.side .node {
		border: 2px solid var(--c-side);
	}
	.commit.life .node {
		border: 2px solid var(--c-life);
	}
	.on-main.main .node {
		background: var(--c-main);
	}
	.on-main.education .node {
		background: var(--c-education);
	}
	.on-main.accident .node {
		background: var(--c-accident);
	}
	.on-main.travel .node {
		background: var(--c-travel);
	}
	.on-main.side .node {
		background: var(--c-side);
	}
	.on-main.life .node {
		background: var(--c-life);
	}
	.on-main.is-root .node {
		width: 0.5rem;
		height: 0.5rem;
		background: var(--c-travel);
		border: 2px solid var(--c-travel);
	}
	/* hidden merge junction: a small neutral dot on the trunk (links only, no card) */
	.commit.is-junction .node {
		border: 2px solid var(--border);
		background: var(--border);
		width: 0.4rem;
		height: 0.4rem;
	}
	.commit.is-junction .card {
		padding-bottom: 1.2rem;
	}
	.commit.is-junction .links {
		margin-top: -0.15rem;
		font-size: 0.72rem;
	}

	/* pulsing rings — inset:0 so the ring is exactly concentric with the node */
	.commit[data-id='now'] .node::after,
	.commit[data-id='dad'] .node::after,
	.commit[data-id='married'] .node::after,
	.commit[data-id='born'] .node::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid var(--c-main);
		animation: pulse-ring 1.8s ease-out infinite;
	}
	.commit[data-id='born'] .node::after {
		border-color: var(--c-travel);
	}
	@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 0.8;
		}
		100% {
			transform: scale(3.4);
			opacity: 0;
		}
	}
	/* the two life-defining moments: gold dots (same size as the HEAD) */
	.commit[data-id='dad'] .node,
	.commit[data-id='married'] .node {
		border: 2px solid #f0b90b;
		background: #f0b90b;
	}
	.commit[data-id='dad'] .node::after,
	.commit[data-id='married'] .node::after {
		border-color: #f0b90b;
	}
	@media (prefers-reduced-motion: reduce) {
		.commit[data-id='now'] .node::after,
		.commit[data-id='dad'] .node::after,
		.commit[data-id='married'] .node::after,
		.commit[data-id='born'] .node::after {
			animation: none;
		}
	}

	/* cards ----------------------------------------------------------------- */
	.title {
		font-size: 0.95rem;
		margin: 0.15rem 0 0.25rem;
		line-height: 1.35;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 0.5rem;
	}
	.is-root .title {
		font-weight: bold;
	}
	.yr {
		font-size: 0.7rem;
		color: var(--muted);
		font-weight: normal;
		white-space: nowrap;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.62rem;
		letter-spacing: 0.02em;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-weight: normal;
		white-space: nowrap;
		color: var(--chip);
		border: 1px solid var(--chip);
		background: color-mix(in srgb, var(--chip) 12%, transparent);
	}
	.desc {
		margin: 0 0 0.4rem;
		font-size: 0.82rem;
		color: var(--muted);
		line-height: 1.5;
	}
	.links {
		margin: 0 0 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 0.8rem;
		font-size: 0.78rem;
	}
	.yt-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		max-width: 14rem;
		min-width: 0;
	}
	.yt-ico {
		width: 1.05em;
		height: 1.05em;
		flex-shrink: 0;
	}
	.yt-label {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	/* external links carry the destination site's favicon (see the map above) */
	.fav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}
	.link-favicon {
		width: 1em;
		height: 1em;
		flex-shrink: 0;
		border-radius: 2px;
	}

	/* margin annotation: pushed into the outer gutter and typed out char-by-char while
	   the card is hovered (JS toggles .show). */
	.tip-note {
		position: absolute;
		top: 0;
		z-index: 5;
		width: 14rem;
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.7;
		font-style: italic;
		color: var(--muted);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}
	.tip-note.show {
		opacity: 1;
	}
	/* blinking caret while the text is being typed */
	.tip-note.typing::after {
		content: '▏';
		margin-left: -0.1em;
		animation: tip-caret 0.8s steps(1) infinite;
	}
	@keyframes tip-caret {
		50% {
			opacity: 0;
		}
	}
	/* padding (not margin) pushes the text into the gutter while the box stays flush
	   against the card */
	.commit.side-right .tip-note {
		left: 100%;
		padding: 1.4rem 0 1.4rem 7rem;
		text-align: left;
	}
	.commit.side-left .tip-note {
		right: 100%;
		padding: 1.4rem 7rem 1.4rem 0;
		text-align: right;
	}

	/* skill / tech badges --------------------------------------------------- */
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.3rem;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.68rem;
		line-height: 1;
		padding: 0.22rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
	}
	.badge-dark {
		color: #fff;
	}
	.badge-light {
		color: #111;
	}
	.badge .logo {
		font-size: 0.85rem;
		line-height: 1;
	}

	/* a small "has photos" marker in the title, e.g. "3 [icon]" */
	.photo-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font: inherit;
		font-size: 0.62rem;
		font-weight: normal;
		color: var(--muted);
		white-space: nowrap;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}
	.photo-badge:hover,
	.photo-badge:focus-visible {
		color: var(--fg);
	}
	.photo-ico {
		width: 1.15em;
		height: 1.15em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* edge photos: land in the outer column opposite the card, casually tilted, and
	   pop from 80% -> 100% when the card is hovered */
	.photos {
		position: absolute;
		/* `.commit` is centred in the viewport, so its 50% == the page centre; offset by
		   a third of the page width to sit the photo group in the middle of the outer
		   third of the page (out in the margin, clear of the content column) */
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		z-index: 5;
		width: 19rem;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
		pointer-events: none;
	}
	/* a single photo takes one narrow column */
	.photos[data-count='1'] {
		width: 13rem;
		grid-template-columns: 1fr;
	}
	/* three photos form a triangle: one tall on the side, two stacked beside it */
	.photos[data-count='3'] {
		grid-template-rows: repeat(2, 1fr);
	}
	.photos[data-count='3'] .photo:nth-child(1) {
		grid-row: 1 / span 2;
		align-self: center;
	}
	.photos[data-count='3'] .photo:nth-child(2) {
		grid-column: 2;
		grid-row: 1;
	}
	.photos[data-count='3'] .photo:nth-child(3) {
		grid-column: 2;
		grid-row: 2;
	}
	.photo {
		margin: 0;
		--tilt: 0deg;
		--dx: 0px;
		--i: 0;
		opacity: 0;
		transform: translateX(var(--dx)) rotate(var(--tilt)) scale(0.8);
		transition:
			transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.3s ease;
	}
	.card:hover ~ .photos .photo,
	.card:focus-within ~ .photos .photo {
		opacity: 1;
		transform: translateX(var(--dx)) rotate(var(--tilt)) scale(1);
		transition-delay: calc(var(--i) * 0.06s);
	}
	.photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
		background: var(--bg);
		box-shadow: 0 3px 14px rgba(0, 0, 0, 0.18);
	}
	/* push photos out past the card, on the SAME side as the card, into the page
	   margin so they never overlap other cards' content */
	.commit.side-right .photos {
		left: calc(50% + 100vw / 3);
	}
	.commit.side-left .photos {
		left: calc(50% - 100vw / 3);
	}
	@media (prefers-reduced-motion: reduce) {
		.photo {
			transition: none;
		}
	}

	/* full-screen carousel opened by tapping a .photo-badge — the .photos hover
	   group stays in the DOM (hidden on mobile) purely as the image source. */
	.photo-lightbox {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.9);
	}
	.photo-lightbox[hidden] {
		display: none;
	}
	.lightbox-img {
		max-width: min(92vw, 32rem);
		max-height: 82vh;
		border-radius: 8px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
	}
	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		background: none;
		border: none;
		color: #fff;
		font-size: 1.8rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.6rem;
	}
	.lightbox-close {
		top: 0.5rem;
		right: 0.5rem;
	}
	.lightbox-prev {
		left: 0.25rem;
		top: 50%;
		transform: translateY(-50%);
	}
	.lightbox-next {
		right: 0.25rem;
		top: 50%;
		transform: translateY(-50%);
	}
	.lightbox-prev[hidden],
	.lightbox-next[hidden] {
		display: none;
	}
	.lightbox-counter {
		position: absolute;
		bottom: 1rem;
		left: 50%;
		transform: translateX(-50%);
		color: rgba(255, 255, 255, 0.75);
		font-size: 0.8rem;
	}

	/* on narrow screens collapse every branch onto a single left rail with cards
	   on the right — the multi-lane layout is too wide for a phone */
	@media (max-width: 680px) {
		.year-sep {
			margin-left: 0;
			margin-right: 0;
			flex-direction: row-reverse;
		}
		.gitgraph {
			--lane-w: 1.2rem;
			--gutter: var(--lane-w);
		}
		.commit {
			grid-template-columns: var(--gutter) 1fr;
		}
		.graph-cell {
			grid-column: 1;
		}
		.node,
		.commit.side-left .node,
		.commit.side-right .node {
			left: calc(var(--lane-w) / 2);
		}
		.card,
		.commit.side-left .card {
			grid-column: 2;
			text-align: left;
		}
		.commit.side-left .title,
		.commit.side-left .links,
		.commit.side-left .badges {
			justify-content: flex-start;
		}
		.title {
			font-size: 0.9rem;
		}
		/* margin annotations and edge photos have no room on a phone */
		.tip-note,
		.commit .tip-note,
		.commit.side-left .tip-note,
		.commit.side-right .tip-note {
			display: none;
		}
		.photos,
		.commit .photos,
		.commit.side-left .photos,
		.commit.side-right .photos {
			display: none;
		}
	}
</style>

<script>
	// Singleton full-screen carousel for a commit's photos, opened by tapping its
	// .photo-badge. Rebuilt lazily if a prior navigation left a detached element
	// behind (ClientRouter swaps the body, dropping anything appended to it).
	let lightbox: {
		el: HTMLElement;
		open: (srcs: string[]) => void;
		close: () => void;
		prev: () => void;
		next: () => void;
	} | null = null;

	// Bound once, ever — reads whichever lightbox instance is current instead of being
	// re-bound (and leaked) each time ensureLightbox() rebuilds after a navigation.
	document.addEventListener('keydown', (e) => {
		if (!lightbox || lightbox.el.hidden) return;
		if (e.key === 'Escape') lightbox.close();
		else if (e.key === 'ArrowLeft') lightbox.prev();
		else if (e.key === 'ArrowRight') lightbox.next();
	});

	function ensureLightbox() {
		if (lightbox && document.body.contains(lightbox.el)) return lightbox;

		const el = document.createElement('div');
		el.className = 'photo-lightbox';
		el.hidden = true;
		el.innerHTML = `
			<button type="button" class="lightbox-close" aria-label="Close">✕</button>
			<button type="button" class="lightbox-prev" aria-label="Previous photo">‹</button>
			<img class="lightbox-img" alt="" />
			<button type="button" class="lightbox-next" aria-label="Next photo">›</button>
			<span class="lightbox-counter"></span>
		`;
		document.body.appendChild(el);

		const img = el.querySelector<HTMLImageElement>('.lightbox-img')!;
		const counter = el.querySelector<HTMLElement>('.lightbox-counter')!;
		const prevBtn = el.querySelector<HTMLButtonElement>('.lightbox-prev')!;
		const nextBtn = el.querySelector<HTMLButtonElement>('.lightbox-next')!;

		let srcs: string[] = [];
		let index = 0;

		const render = () => {
			img.src = srcs[index];
			counter.textContent = `${index + 1} / ${srcs.length}`;
			const single = srcs.length < 2;
			prevBtn.hidden = single;
			nextBtn.hidden = single;
		};
		const close = () => {
			el.hidden = true;
			document.body.classList.remove('lightbox-open');
		};
		const prev = () => {
			index = (index - 1 + srcs.length) % srcs.length;
			render();
		};
		const next = () => {
			index = (index + 1) % srcs.length;
			render();
		};
		const open = (photoSrcs: string[]) => {
			srcs = photoSrcs;
			index = 0;
			render();
			el.hidden = false;
			document.body.classList.add('lightbox-open');
		};

		prevBtn.addEventListener('click', prev);
		nextBtn.addEventListener('click', next);
		el.querySelector('.lightbox-close')!.addEventListener('click', close);
		el.addEventListener('click', (e) => {
			if (e.target === el) close(); // backdrop click
		});
		let touchStartX = 0;
		el.addEventListener('touchstart', (e) => {
			touchStartX = e.changedTouches[0].clientX;
		});
		el.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - touchStartX;
			if (Math.abs(dx) > 40) (dx > 0 ? prev : next)();
		});

		lightbox = { el, open, close, prev, next };
		return lightbox;
	}

	function drawOne(graph: HTMLElement) {
		const svg = graph.querySelector<SVGSVGElement>('.graph-edges');
		const dataEl = graph.querySelector<HTMLElement>('.graph-edges-data');
		if (!svg || !dataEl) return;
		// ClientRouter fires astro:page-load on the initial load too, so initGraphs()
		// runs twice — guard against binding duplicate listeners (which would make the
		// flip toggle fire twice per click and cancel itself out).
		if (graph.dataset.ginit) return;
		graph.dataset.ginit = '1';

		// tapping a photo badge opens that commit's photos in a full-screen carousel
		// (the .photos figures already hold the <img>s; on mobile they're just hidden).
		graph.querySelectorAll<HTMLButtonElement>('.photo-badge').forEach((badge) => {
			const commit = badge.closest<HTMLElement>('.commit');
			const srcs = [...(commit?.querySelectorAll<HTMLImageElement>('.photos img') ?? [])].map(
				(img) => img.src,
			);
			if (!srcs.length) return;
			badge.addEventListener('click', () => ensureLightbox().open(srcs));
		});

		const edges: {
			from: string;
			to: string;
			branch: string;
			color: string | null;
			railFrom: boolean;
		}[] = JSON.parse(dataEl.textContent || '[]');
		const SVGNS = 'http://www.w3.org/2000/svg';

		function draw() {
			const box = graph.getBoundingClientRect();
			const pos: Record<string, { x: number; y: number }> = {};
			graph.querySelectorAll<HTMLElement>('[data-node]').forEach((n) => {
				const r = n.getBoundingClientRect();
				if (!r.width) return;
				pos[n.dataset.id!] = {
					x: r.left - box.left + r.width / 2,
					y: r.top - box.top + r.height / 2,
				};
			});
			svg!.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
			svg!.setAttribute('width', String(box.width));
			svg!.setAttribute('height', String(box.height));
			while (svg!.firstChild) svg!.removeChild(svg!.firstChild);

			for (const e of edges) {
				const a = pos[e.from];
				const b = pos[e.to];
				if (!a || !b) continue; // an endpoint isn't rendered (e.g. teaser)
				const p = document.createElementNS(SVGNS, 'path');
				let d: string;
				if (Math.abs(a.x - b.x) < 0.5) {
					d = `M ${a.x} ${a.y} L ${b.x} ${b.y}`;
				} else {
					// keep the vertical in the branch lane (`rail`) and bend into the
					// trunk-ward endpoint (`junc`) only next to it.
					const rail = e.railFrom ? a : b;
					const junc = e.railFrom ? b : a;
					const bend = Math.min(22, Math.abs(a.y - b.y) * 0.5);
					if (junc.y > rail.y) {
						// checkout: down the rail lane, then bend into the junction below
						d = `M ${rail.x} ${rail.y} L ${rail.x} ${junc.y - bend} C ${rail.x} ${junc.y}, ${junc.x} ${junc.y - bend}, ${junc.x} ${junc.y}`;
					} else {
						// merge: bend out of the junction above, then down the rail lane
						d = `M ${junc.x} ${junc.y} C ${junc.x} ${junc.y + bend}, ${rail.x} ${junc.y}, ${rail.x} ${junc.y + bend} L ${rail.x} ${rail.y}`;
					}
				}
				p.setAttribute('d', d);
				if (e.color) p.style.stroke = e.color;
				p.dataset.branch = e.branch;
				p.dataset.from = e.from;
				p.dataset.to = e.to;
				svg!.appendChild(p);
			}
		}

		let raf = 0;
		const schedule = () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(draw);
		};
		draw();
		if (document.fonts?.ready) document.fonts.ready.then(draw);
		window.addEventListener('resize', schedule);
		window.addEventListener('load', draw);

		// margin tip notes: shown while the card is hovered, typed out char-by-char the
		// first time. On mobile / reduced-motion the full text is shown with no typing.
		const noAnim =
			window.matchMedia('(max-width: 680px)').matches ||
			window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		graph.querySelectorAll<HTMLElement>('.tip-note').forEach((note) => {
			const full = note.dataset.tip || '';
			if (noAnim) {
				note.textContent = full;
				note.classList.add('show');
				return;
			}
			const card = note.closest<HTMLElement>('.commit')?.querySelector<HTMLElement>('.card');
			if (!card) return;
			note.textContent = '';
			let typer: ReturnType<typeof setInterval> | undefined;
			card.addEventListener('mouseenter', () => {
				note.classList.add('show', 'typing');
				clearInterval(typer);
				note.textContent = '';
				let i = 0;
				typer = setInterval(() => {
					note.textContent = full.slice(0, ++i);
					if (i >= full.length) {
						clearInterval(typer);
						note.classList.remove('typing');
					}
				}, 22);
			});
			card.addEventListener('mouseleave', () => {
				clearInterval(typer);
				note.classList.remove('show', 'typing');
			});
		});

		// highlight a commit's node + the branch it lives on in the path; shared by the
		// desktop hover binding below and the mobile scroll-linked activation further down.
		function highlight(commit: HTMLElement) {
			const id = commit.dataset.id;
			const branch = commit.dataset.branch;
			const onMain = commit.classList.contains('on-main');
			const node = commit.querySelector<HTMLElement>('.node');
			graph.classList.add('graph-active');
			node?.classList.add('hl');
			svg!.querySelectorAll<SVGPathElement>('path').forEach((p) => {
				// edges belonging to this commit's branch, plus edges touching this node —
				// but for a commit on `main`, don't light a branch's checkout/merge edge
				// just because it connects here; those aren't part of main.
				const touches = p.dataset.from === id || p.dataset.to === id;
				if (p.dataset.branch === branch || (touches && !(onMain && p.dataset.branch !== 'main')))
					p.classList.add('hl');
			});
		}
		function unhighlight(commit: HTMLElement) {
			graph.classList.remove('graph-active');
			commit.querySelector<HTMLElement>('.node')?.classList.remove('hl');
			svg!.querySelectorAll<SVGPathElement>('path.hl').forEach((p) => p.classList.remove('hl'));
		}

		// hover a card -> highlight its commit node and the branch it lives on in the path.
		// bind to the card (not the full-width .commit row) so hovering the empty space on
		// the opposite side at the same level doesn't trigger a highlight.
		graph.querySelectorAll<HTMLElement>('.commit').forEach((commit) => {
			const card = commit.querySelector<HTMLElement>('.card');
			if (!card) return;
			card.addEventListener('mouseenter', () => highlight(commit));
			card.addEventListener('mouseleave', () => unhighlight(commit));
		});

		// phones have no hover: instead, whichever commit sits closest to a line a third
		// of the way down the viewport becomes "active" as the user scrolls, with a short
		// vibration marking each hand-off so the effect reads as tactile, not just visual.
		// Proximity (not a fixed crossing-point) is what's compared, so every commit gets
		// an activation window sized to its own spacing — including the last few, which
		// stay fairly split between them even once the page runs out of room to scroll
		// any single one of them all the way up to the line.
		if (window.matchMedia('(max-width: 680px)').matches) {
			const commits = [...graph.querySelectorAll<HTMLElement>('.commit')].filter(
				(c) => !c.classList.contains('is-junction'),
			);
			if (commits.length) {
				let active: HTMLElement | null = null;
				const setActive = (commit: HTMLElement | null) => {
					if (commit === active) return;
					if (active) {
						unhighlight(active);
						active.classList.remove('active-mobile');
					}
					active = commit;
					if (active) {
						highlight(active);
						active.classList.add('active-mobile');
						navigator.vibrate?.(12);
					}
				};

				const restLine = 0.32; // where on screen the eye naturally rests while scrolling
				let raf = 0;
				const update = () => {
					raf = 0;
					const vh = window.innerHeight;
					const doc = document.documentElement;
					const maxScroll = Math.max(0, doc.scrollHeight - vh);
					// Near the very bottom there may not be enough page left to carry each of
					// the last few commits up to the resting line individually — once within
					// one screen's height of the end, sweep that line down toward the bottom
					// of the viewport instead, so the remaining scroll distance still passes
					// it through each trailing commit in turn rather than stranding them all
					// below a line that can never reach them.
					const distFromBottom = maxScroll - window.scrollY;
					const t = vh > 0 ? Math.max(0, Math.min(1, 1 - distFromBottom / vh)) : 0;
					const anchorY = vh * (restLine + t * (0.92 - restLine));

					let closest = commits[0];
					let closestDist = Infinity;
					for (const c of commits) {
						const dist = Math.abs(c.getBoundingClientRect().top - anchorY);
						if (dist < closestDist) {
							closestDist = dist;
							closest = c;
						}
					}
					setActive(closest);
				};
				const schedule = () => {
					if (!raf) raf = requestAnimationFrame(update);
				};

				schedule();
				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
			}
		}

		// "start from birth" flips the timeline (oldest at top); edges follow because
		// draw() reads the live node positions after the reorder.
		const head = graph.previousElementSibling as HTMLElement | null;
		const toggle = head?.querySelector<HTMLElement>('.flip-toggle') ?? null;
		if (toggle) {
			const label = toggle.querySelector<HTMLElement>('.flip-label');
			toggle.addEventListener('click', () => {
				const flipped = graph.classList.toggle('flipped');
				toggle.setAttribute('aria-pressed', String(flipped));
				if (label) label.textContent = flipped ? 'start from now' : 'start from birth';
				draw();
			});
		}
	}

	function initGraphs() {
		document.querySelectorAll<HTMLElement>('.gitgraph').forEach(drawOne);
	}

	initGraphs();
	document.addEventListener('astro:page-load', initGraphs);
</script>
