// Sort strictly by time so the vertical order is chronological — a 2023 event
// never renders above a 2025 one — while parents still precede their children.
const commits: Commit[] = [...history].sort((a, b) => a.t - b.t);

// --- Branch & milestone flavour --------------------------------------------
// Every branch gets its own RPG-style label, colour and icon (so no two
// branches read alike). Commits on `main` instead take a chip derived from
// their kind — accidents are "character development", degrees are "+1 XP", etc.
type Chip = { label: string; icon: string; color: string };
const BRANCH_META: Record<string, Chip> = {
	streets:   { label: 'free roam',   icon: '🛹', color: '#e5722a' },
	wild:      { label: 'wandering',   icon: '🏕️', color: '#96692e' },
	contests:  { label: 'achievement', icon: '🏆', color: '#d99e00' },
	freelance: { label: 'level up',    icon: '🛠️', color: '#2f7ee5' },
	research:  { label: 'research',    icon: '🔬', color: '#0891b2' },
	ventures:  { label: 'world map',   icon: '🧭', color: '#10a5a5' },
	oss:       { label: 'crafting',    icon: '⚒️', color: '#9333ea' },
	lisptc:    { label: 'crafting',    icon: '⚒️', color: '#9333ea' },
	bigmama:   { label: 'campaign',    icon: '⚔️', color: '#5b5bd6' },
};
const TYPE_CHIP: Partial<Record<Commit['type'], Chip>> = {
	accident:  { label: 'character development', icon: '💔', color: '#e5484d' },
	education: { label: '+1 XP',                  icon: '🎓', color: '#8e4ec6' },
	travel:    { label: 'world map',              icon: '🧭', color: '#10a5a5' },
};
// per-commit chip overrides — win over branch/type chips
const CHIP_OVERRIDE: Record<string, Chip> = {
	hackathon: { label: '+1 XP',   icon: '', color: '#8e4ec6' },
	dad:       { label: '+∞ love', icon: '', color: '#db2777' },
};
const chipFor = (c: Commit): Chip | undefined =>
	CHIP_OVERRIDE[c.id] ?? (c.branch !== 'main' ? BRANCH_META[c.branch] : TYPE_CHIP[c.type]);

// --- Lane assignment (the "viz algo") --------------------------------------
const indexOf: Record<string, number> = {};
commits.forEach((c, i) => (indexOf[c.id] = i));

type Span = { branch: string; start: number; end: number };
const spans: Record<string, Span> = {};
for (const c of commits) {
	if (c.branch === 'main') continue;
	if (!spans[c.branch]) spans[c.branch] = { branch: c.branch, start: indexOf[c.id], end: indexOf[c.id] };
	spans[c.branch].end = indexOf[c.id];
}
// extend each span up to the merge commit that consumes its tip
for (const c of commits) {
	if (c.parents.length < 2) continue;
	for (const p of c.parents) {
		const pb = commits[indexOf[p]].branch;
		if (pb !== 'main' && spans[pb]) spans[pb].end = Math.max(spans[pb].end, indexOf[c.id]);
	}
}
// main holds lane 0. A branch off main alternates right (+) / left (-). A branch
// off another branch stays on that parent's side, one lane further out. A branch
// need not merge — its span just ends at its last commit. Concurrent branches on
// the same side take the lowest free magnitude so they never collide.
// pin specific branches to a side (1 = right, -1 = left) regardless of the
// alternation, e.g. lisptc should sit on the left just under `now`.
const FORCE_SIDE: Record<string, number> = { lisptc: -1 };
const laneOf: Record<string, number> = { main: 0 };
const freeOn: Record<string, number[]> = { '1': [], '-1': [] };
let altSide = 1;
for (const s of Object.values(spans).sort((a, b) => a.start - b.start)) {
	const first = commits[s.start];
	const parentBranch = first.parents.length ? commits[indexOf[first.parents[0]]].branch : 'main';
	let sign: number;
	let minMag: number;
	if (FORCE_SIDE[s.branch] !== undefined) {
		sign = FORCE_SIDE[s.branch];
		minMag = 1;
	} else if (parentBranch === 'main' || laneOf[parentBranch] === undefined) {
		sign = altSide;
		altSide = -altSide;
		minMag = 1;
	} else {
		sign = Math.sign(laneOf[parentBranch]) || altSide;
		minMag = Math.abs(laneOf[parentBranch]) + 1;
	}
	const free = freeOn[String(sign)];
	let m = minMag;
	while (free[m] !== undefined && free[m] > s.start) m++;
	free[m] = s.end;
	laneOf[s.branch] = sign * m;
}
const lanes = Object.values(laneOf);
const minLane = Math.min(...lanes);
const maxLane = Math.max(...lanes);
const laneCount = maxLane - minLane + 1;

// place a specific commit's card on a chosen side (its node stays on its lane)
const CARD_SIDE: Record<string, 'left' | 'right'> = { social: 'left', masters: 'right', married: 'left', dad: 'left', ghana: 'left', hypnosis: 'left', linkedin: 'left' };

// render newest -> oldest (top of page = latest)
const rows = [...commits].reverse().map((c) => ({
	...c,
	lane: laneOf[c.branch] - minLane,
	side: (CARD_SIDE[c.id] ?? (laneOf[c.branch] < 0 ? 'left' : 'right')) as 'left' | 'right',
	chip: chipFor(c),
}));

// flat edge list for the client-side renderer: child -> parent, tinted with the
// colour of whichever branch it belongs to; pure trunk edges stay null.
const EDGES = commits.flatMap((c) =>
	c.parents.map((p) => {
		const parentBranch = commits[indexOf[p]].branch;
		const b = c.branch !== 'main' ? c.branch : parentBranch !== 'main' ? parentBranch : null;
		return { from: c.id, to: p, color: b ? BRANCH_META[b].color : null };
	}),
);

const LEGEND = [
	{ type: 'main', label: 'main' },
	{ type: 'education', label: 'education' },
	{ type: 'travel', label: 'travel' },
	{ type: 'accident', label: 'accident' },
	{ type: 'side', label: 'project' },
	{ type: 'life', label: 'life' },
];

interface Props {
	limit?: number;         // render only the newest N commits (a teaser)
	showLegend?: boolean;   // show the colour key
	preview?: boolean;      // non-interactive teaser mode
}
const { limit, showLegend = false, preview = false } = Astro.props;
const visibleRows = typeof limit === 'number' ? rows.slice(0, limit) : rows;
---

{showLegend && (
	<ul class="legend" aria-label="colour key">
		{LEGEND.map((l) => (
			<li class="legend-item"><span class={`dot ${l.type}`}></span>{l.label}</li>
		))}
	</ul>
)}

<div class:list={['gitgraph', { preview }]} style={`--lanes:${laneCount}`}>
	<svg class="graph-edges" aria-hidden="true"></svg>
	<script type="application/json" class="graph-edges-data" set:html={JSON.stringify(EDGES)} is:inline></script>
	{visibleRows.map((c) => (
		<div
			class={['commit', c.type, c.branch === 'main' ? 'on-main' : 'on-branch', `side-${c.side}`, c.root ? 'is-root' : ''].join(' ')}
			data-type={c.type}
			data-id={c.id}
		>
			<div class="graph-cell">
				<span class="node" data-node data-id={c.id} style={`--lane:${c.lane}`}></span>
			</div>
			<div class="card">
				<h3 class="title">
					<span class="yr">{c.year}</span>
					{c.tip ? (
						<span class="has-tooltip">
							{c.title}
							<span class="tooltip"><span class="tooltip-text">{c.tip}</span></span>
						</span>
					) : c.title}
					{c.chip && (
						<span class="chip" style={`--chip:${c.chip.color}`}>{c.chip.label}</span>
					)}
				</h3>
				{c.desc && <p class="desc">{c.desc}</p>}
				{c.links && (
					<p class="links">
						{c.links.map((lk) => {
							const yt = lk.href.includes('youtube.com') || lk.href.includes('youtu.be');
							return (
								<a href={lk.href} class={yt ? 'yt-link' : undefined} target={lk.href.startsWith('http') ? '_blank' : undefined} rel={lk.href.startsWith('http') ? 'noopener' : undefined}>
									{yt && (
										<svg class="yt-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="#FF0000" d="M23 7.5a3 3 0 00-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 001 7.5 31 31 0 00.5 12 31 31 0 001 16.5a3 3 0 002.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5A3 3 0 0023 16.5 31 31 0 0023.5 12 31 31 0 0023 7.5z"/><path fill="#fff" d="M9.75 15.5v-7l6 3.5z"/></svg>
									)}
									{yt ? <span class="yt-label" title={lk.label}>{lk.label}</span> : lk.label}
								</a>
							);
						})}
					</p>
				)}
				{c.tech && (
					<div class="badges">
						{c.tech.map((k) => {
							const t = TECH[k];
							return (
								<span class={`badge ${t.dark ? 'badge-dark' : 'badge-light'}`} style={`background:${t.bg}`}>
									{t.icon && <i class={`logo ${t.icon}`} aria-hidden="true"></i>}
									{t.label}
								</span>
							);
						})}
					</div>
				)}
			</div>
		</div>
	))}
</div>

<style is:global>
	/* the full graph breaks out of the default reading column; the preview does not */
	main:has(.gitgraph:not(.preview)) { max-width: 56rem; }
</style>

<style>
	/* legend (static colour key) ------------------------------------------- */
	.legend {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
	.dot {
		width: 0.7rem; height: 0.7rem; border-radius: 50%;
		display: inline-block; flex-shrink: 0;
	}
	.dot.main { background: var(--c-main); }
	.dot.education { background: var(--c-education); }
	.dot.accident { background: var(--c-accident); }
	.dot.travel { background: var(--c-travel); }
	.dot.side { background: var(--c-side); }
	.dot.life { background: var(--c-life); }

	/* git graph ------------------------------------------------------------- */
	.gitgraph {
		position: relative;
		margin: 0 0 2rem;
		--lane-w: 1.35rem;
		--node-y: 1rem;
		--gutter: calc(var(--lanes) * var(--lane-w));
	}
	.gitgraph.preview { pointer-events: none; margin: 0; }
	.graph-edges {
		position: absolute;
		inset: 0;
		width: 100%; height: 100%;
		pointer-events: none;
		overflow: visible;
		z-index: 0;
	}
	.graph-edges :global(path) {
		fill: none;
		stroke: var(--border);
		stroke-width: 2;
	}

	.commit {
		display: grid;
		grid-template-columns: 1fr var(--gutter) 1fr;
		align-items: start;
	}

	.graph-cell { grid-column: 2; position: relative; }
	.card { grid-column: 3; min-width: 0; padding-bottom: 1.7rem; position: relative; z-index: 1; }
	.commit.side-left .card { grid-column: 1; text-align: right; }
	.commit.side-left .title,
	.commit.side-left .links,
	.commit.side-left .badges { justify-content: flex-end; }
	.node {
		position: absolute;
		left: calc(var(--lane) * var(--lane-w) + var(--lane-w) / 2);
		top: var(--node-y);
		width: 0.55rem; height: 0.55rem;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		background: var(--bg);
		box-shadow: 0 0 0 3px var(--bg);
		z-index: 2;
	}
	.commit.main .node { border: 2px solid var(--c-main); }
	.commit.education .node { border: 2px solid var(--c-education); }
	.commit.accident .node { border: 2px solid var(--c-accident); }
	.commit.travel .node { border: 2px solid var(--c-travel); }
	.commit.side .node { border: 2px solid var(--c-side); }
	.commit.life .node { border: 2px solid var(--c-life); }
	.on-main.main .node { background: var(--c-main); }
	.on-main.education .node { background: var(--c-education); }
	.on-main.accident .node { background: var(--c-accident); }
	.on-main.travel .node { background: var(--c-travel); }
	.on-main.side .node { background: var(--c-side); }
	.on-main.life .node { background: var(--c-life); }
	.is-root .node { width: 0.9rem; height: 0.9rem; background: var(--c-life); }

	/* the "now" commit pulses to signal it's the live HEAD */
	.commit[data-id="now"] .node::after {
		content: '';
		position: absolute;
		left: 50%; top: 50%;
		width: 100%; height: 100%;
		border-radius: 50%;
		border: 2px solid var(--c-main);
		transform: translate(-50%, -50%) scale(1);
		animation: now-pulse 1.8s ease-out infinite;
	}
	@keyframes now-pulse {
		0%   { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
		100% { transform: translate(-50%, -50%) scale(3.4); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.commit[data-id="now"] .node::after { animation: none; }
	}

	/* cards ----------------------------------------------------------------- */
	.title {
		font-size: 0.95rem;
		margin: 0.15rem 0 0.25rem;
		line-height: 1.35;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 0.5rem;
	}
	.is-root .title { font-weight: bold; }
	.yr { font-size: 0.7rem; color: var(--muted); font-weight: normal; white-space: nowrap; }
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.62rem;
		letter-spacing: 0.02em;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-weight: normal;
		white-space: nowrap;
		color: var(--chip);
		border: 1px solid var(--chip);
		background: color-mix(in srgb, var(--chip) 12%, transparent);
	}
	.desc { margin: 0 0 0.4rem; font-size: 0.82rem; color: var(--muted); line-height: 1.5; }
	.links {
		margin: 0 0 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 0.8rem;
		font-size: 0.78rem;
	}
	.yt-link { display: inline-flex; align-items: center; gap: 0.3rem; max-width: 14rem; min-width: 0; }
	.yt-ico { width: 1.05em; height: 1.05em; flex-shrink: 0; }
	.yt-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.has-tooltip {
		position: relative;
		text-decoration: underline dotted;
		text-underline-offset: 3px;
		cursor: help;
	}

	/* skill / tech badges --------------------------------------------------- */
	.badges { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.3rem; }
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.68rem;
		line-height: 1;
		padding: 0.22rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
	}
	.badge-dark { color: #fff; }
	.badge-light { color: #111; }
	.badge .logo { font-size: 0.85rem; line-height: 1; }

	/* on narrow screens collapse to a single left rail with cards on the right */
	@media (max-width: 680px) {
		.gitgraph { --lane-w: 1.2rem; }
		.commit { grid-template-columns: var(--gutter) 1fr; }
		.graph-cell { grid-column: 1; }
		.card, .commit.side-left .card { grid-column: 2; text-align: left; }
		.commit.side-left .title,
		.commit.side-left .links,
		.commit.side-left .badges { justify-content: flex-start; }
		.title { font-size: 0.9rem; }
	}
</style>

<script>
	function drawOne(graph: HTMLElement) {
		const svg = graph.querySelector<SVGSVGElement>('.graph-edges');
		const dataEl = graph.querySelector<HTMLElement>('.graph-edges-data');
		if (!svg || !dataEl) return;
		const edges: { from: string; to: string; color: string | null }[] = JSON.parse(dataEl.textContent || '[]');
		const SVGNS = 'http://www.w3.org/2000/svg';

		function draw() {
			const box = graph.getBoundingClientRect();
			const pos: Record<string, { x: number; y: number }> = {};
			graph.querySelectorAll<HTMLElement>('[data-node]').forEach((n) => {
				const r = n.getBoundingClientRect();
				if (!r.width) return;
				pos[n.dataset.id!] = { x: r.left - box.left + r.width / 2, y: r.top - box.top + r.height / 2 };
			});
			svg!.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
			svg!.setAttribute('width', String(box.width));
			svg!.setAttribute('height', String(box.height));
			while (svg!.firstChild) svg!.removeChild(svg!.firstChild);

			for (const e of edges) {
				const a = pos[e.from];
				const b = pos[e.to];
				if (!a || !b) continue; // an endpoint isn't rendered (e.g. teaser)
				const p = document.createElementNS(SVGNS, 'path');
				let d: string;
				if (Math.abs(a.x - b.x) < 0.5) {
					d = `M ${a.x} ${a.y} L ${b.x} ${b.y}`;
				} else {
					const bend = Math.min(22, Math.abs(b.y - a.y) * 0.5);
					d = `M ${a.x} ${a.y} L ${a.x} ${b.y - bend} C ${a.x} ${b.y}, ${b.x} ${b.y - bend}, ${b.x} ${b.y}`;
				}
				p.setAttribute('d', d);
				if (e.color) p.style.stroke = e.color;
				svg!.appendChild(p);
			}
		}

		let raf = 0;
		const schedule = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); };
		draw();
		if (document.fonts?.ready) document.fonts.ready.then(draw);
		window.addEventListener('resize', schedule);
		window.addEventListener('load', draw);

		// tooltips (skipped in preview mode — pointer events are disabled there)
		let timer: ReturnType<typeof setTimeout> | null = null;
		graph.querySelectorAll<HTMLElement>('.has-tooltip').forEach((trigger) => {
			const tip = trigger.querySelector<HTMLElement>('.tooltip');
			if (!tip) return;
			const place = (e: MouseEvent) => {
				tip.style.left = e.clientX + 12 + 'px';
				tip.style.top = e.clientY - 28 + 'px';
			};
			trigger.addEventListener('mouseenter', (e) => {
				const me = e as MouseEvent;
				timer = setTimeout(() => { place(me); tip.classList.add('visible'); }, 400);
			});
			trigger.addEventListener('mousemove', (e) => place(e as MouseEvent));
			trigger.addEventListener('mouseleave', () => {
				if (timer) { clearTimeout(timer); timer = null; }
				tip.classList.remove('visible');
			});
		});
	}

	function initGraphs() {
		document.querySelectorAll<HTMLElement>('.gitgraph').forEach(drawOne);
	}

	initGraphs();
	document.addEventListener('astro:page-load', initGraphs);
</script>
