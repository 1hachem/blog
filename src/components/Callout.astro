---
interface Props {
	type?: 'note' | 'warning' | 'tip';
}
const { type = 'note' } = Astro.props;
const labels = { note: 'note', warning: 'warning', tip: 'tip' };
---

<aside class={`callout callout-${type}`}>
	<span class="callout-label">[{labels[type]}]</span>
	<slot />
</aside>

<style>
	.callout {
		border: 1px solid var(--border);
		padding: 0.75rem 1rem;
		margin: 1.5rem 0;
		font-size: 0.9rem;
	}
	.callout-warning {
		border-color: #999;
		background: #fafafa;
	}
	.callout-tip {
		border-color: #aaa;
	}
	.callout-label {
		font-weight: bold;
		margin-right: 0.5rem;
	}
</style>
