---
import { SITE_AUTHOR } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div>
		<a href="/rss.xml">rss</a>
		<span>·</span>
		<span>&copy; {year} {SITE_AUTHOR}</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 1rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	footer div {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--fg);
	}
</style>
