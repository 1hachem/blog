---
import { SITE_AUTHOR } from '../consts';
import { getGitInfo } from '../lib/git';

const year = new Date().getFullYear();
const { lastUpdated, commitHash } = getGitInfo();
---

<footer>
	<div>
		{lastUpdated && (
			<span class="updated">updated {lastUpdated} <code>{commitHash}</code></span>
		)}
		<span class="right">
			<a href="/rss.xml">rss</a>
			<span>·</span>
			<span>&copy; {year} {SITE_AUTHOR}</span>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 1rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	footer div {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		gap: 0.5rem;
		align-items: center;
		justify-content: space-between;
	}
	.right {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--fg);
	}
	code {
		font-size: 0.8em;
		opacity: 0.6;
	}
	@media (max-width: 640px) {
		.updated {
			display: none;
		}
	}
</style>
