---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="nav-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<button id="theme-toggle" aria-label="toggle dark mode" title="switch theme">
			<span class="icon-sun">☀</span>
			<span class="icon-moon">☽</span>
		</button>
	</nav>
</header>

<script>
	const btn = document.getElementById('theme-toggle')!;
	const html = document.documentElement;

	btn.addEventListener('click', () => {
		const isDark = html.getAttribute('data-theme') === 'dark';
		html.setAttribute('data-theme', isDark ? 'light' : 'dark');
		localStorage.setItem('theme', isDark ? 'light' : 'dark');
	});
</script>

<style>
	header {
		border-bottom: 1px solid var(--border);
		padding: 0.75rem 1rem;
	}
	nav {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.nav-links {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	#theme-toggle {
		background: none;
		border: none;
		color: var(--muted);
		font-size: 1.1rem;
		line-height: 1;
		padding: 0.2rem;
		cursor: pointer;
		flex-shrink: 0;
	}
	#theme-toggle:hover {
		color: var(--fg);
	}
	/* icons driven by data-theme on <html>, set before paint by inline script in <head> */
	.icon-sun { display: none; }
	.icon-moon { display: inline; }
	:global([data-theme="dark"]) .icon-sun { display: inline; }
	:global([data-theme="dark"]) .icon-moon { display: none; }
</style>
