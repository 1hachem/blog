---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	toc.length >= 2 && (
		<div class="toc">
			<button type="button" class="toc-toggle" aria-expanded="false" aria-controls="toc-panel">
				Table of contents
			</button>
			<nav class="toc-panel" id="toc-panel" aria-label="Table of contents">
				<ol class="toc-list">
					{toc.map((h) => (
						<li class={h.depth === 3 ? 'toc-h3' : 'toc-h2'} data-id={h.slug}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ol>
			</nav>
		</div>
	)
}

<script>
	let io: IntersectionObserver | undefined;

	function setupToc() {
		// Tear down any observer from a previous page (ClientRouter reuses the JS context).
		io?.disconnect();

		const toc = document.querySelector<HTMLElement>('.toc');
		const toggle = toc?.querySelector<HTMLButtonElement>('.toc-toggle');
		if (toc && toggle && !toggle.dataset.bound) {
			toggle.dataset.bound = 'true';
			toggle.addEventListener('click', () => {
				const expanded = toc.classList.toggle('expanded');
				toggle.setAttribute('aria-expanded', String(expanded));
			});
		}

		const list = document.querySelector('.toc-list');
		if (!list) return;

		const items = list.querySelectorAll<HTMLElement>('li[data-id]');
		const idToItem = new Map<string, HTMLElement>();
		for (const item of items) idToItem.set(item.dataset.id!, item);

		const ids = [...idToItem.keys()];
		const headings = ids
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null);

		let activeId = '';
		const setActive = (id: string) => {
			if (id === activeId) return;
			idToItem.get(activeId)?.classList.remove('active');
			activeId = id;
			idToItem.get(activeId)?.classList.add('active');
		};

		const visible = new Set<string>();

		const update = () => {
			const doc = document.documentElement;
			const atBottom = window.innerHeight + Math.ceil(window.scrollY) >= doc.scrollHeight;
			if (atBottom) {
				// The last heading(s) may not have enough page left below them to ever get
				// pushed into the top band — once there's nowhere further to scroll, just
				// force the actual last heading active instead of leaving it unreachable.
				setActive(ids[ids.length - 1] ?? '');
				return;
			}
			if (visible.size > 0) {
				// Highlight the first visible heading in document order.
				const first = ids.find((id) => visible.has(id));
				if (first) setActive(first);
				return;
			}
			// Nothing visible (e.g. scrolled past a long section):
			// highlight the last heading above the viewport top.
			let current = ids[0] ?? '';
			for (const el of headings) {
				if (el.getBoundingClientRect().top <= 100) current = el.id;
				else break;
			}
			setActive(current);
		};

		io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) visible.add(entry.target.id);
					else visible.delete(entry.target.id);
				}
				update();
			},
			{ rootMargin: '0px 0px -70% 0px', threshold: 0 },
		);

		for (const el of headings) io.observe(el);
		window.addEventListener('scroll', update, { passive: true });
		update();
	}

	// Runs on first load and after every ClientRouter navigation.
	document.addEventListener('astro:page-load', setupToc);
</script>

<style>
	.toc {
		font-size: 0.78rem;
		line-height: 1.4;
		border-left: 2px solid var(--border);
		padding-left: 0.75rem;
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc-list li {
		padding: 0.18rem 0;
	}
	.toc-list li a {
		text-decoration: none;
		color: var(--muted);
		display: block;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.toc-list li a:hover {
		color: var(--fg);
	}
	.toc-list li.active > a {
		color: var(--fg);
	}
	.toc-h3 {
		padding-left: 0.8rem;
	}

	.toc-toggle {
		display: none;
	}

	@media (max-width: 700px) {
		.toc-toggle {
			display: flex;
			align-items: center;
			width: 100%;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			font: inherit;
			font-size: 0.85rem;
			color: var(--fg);
		}
		.toc-toggle::before {
			content: '▸';
			display: inline-block;
			margin-right: 0.4rem;
			transition: transform 0.15s ease;
		}
		.toc.expanded .toc-toggle::before {
			transform: rotate(90deg);
		}
		.toc-panel {
			display: none;
		}
		.toc.expanded .toc-panel {
			display: block;
		}
		.toc-list {
			padding-top: 0.6rem;
		}
	}
</style>
