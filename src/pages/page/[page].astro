---
import BaseHead from '../../components/BaseHead.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TimelinePostList from '../../components/TimelinePostList.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getAllPosts, getCategories } from '../../lib/posts';

export async function getStaticPaths() {
	const allPosts = await getAllPosts();
	const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
		const page = i + 2;
		return {
			params: { page: String(page) },
			props: {
				posts: allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
				currentPage: page,
				totalPages,
			},
		};
	});
}

const { posts, currentPage, totalPages } = Astro.props;
const allPosts = await getAllPosts();
const categories = getCategories(allPosts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`page ${currentPage} — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<CategoryFilter categories={categories} />
			<TimelinePostList posts={posts} currentPage={currentPage} totalPages={totalPages} />
		</main>
		<Footer />
	</body>
</html>
