---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lists } from '../../data/lists';

export function getStaticPaths() {
	return lists.map((list) => ({
		params: { list: list.slug },
		props: { list },
	}));
}

const { list } = Astro.props;
const navLinks = [
	{ href: '/', label: '← home' },
	{ href: '/lists', label: 'lists' },
];
---

<BaseLayout title={list.heading} description={list.blurb ?? `my ${list.heading} list`} navLinks={navLinks}>
	<h1>{list.heading}</h1>
	{list.blurb && <p class="blurb">{list.blurb}</p>}

	<ul>
		{list.items.map((item) => (
			<li>
				<span class="title">{item.title}</span>
				{item.note && <span class="note">{item.note}</span>}
			</li>
		))}
	</ul>
</BaseLayout>

<style>
	.blurb {
		color: var(--muted);
		margin: 0 0 1.5rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--border);
	}
	.title {
		font-weight: 500;
	}
	.note {
		color: var(--muted);
		font-size: 0.85rem;
		text-align: right;
		flex-shrink: 0;
	}
	@media (max-width: 500px) {
		li {
			flex-direction: column;
			gap: 0.15rem;
		}
		.note {
			text-align: left;
			font-size: 0.75rem;
		}
	}
</style>
