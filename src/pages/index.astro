---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="home">
		<h1>{SITE_TITLE}</h1>
		<p class="intro">{SITE_DESCRIPTION}</p>
		<nav class="hub" aria-label="site navigation">
			<ul>
				<li><a href="/blog" data-astro-prefetch>blog</a> — read the writing</li>
				<li><a href="/about" data-astro-prefetch>about</a> — who i am</li>
			</ul>
		</nav>
	</section>
</BaseLayout>

<style>
	.home {
		max-width: 42rem;
	}
	.intro {
		color: var(--muted);
		white-space: pre-line;
		margin-bottom: 2rem;
	}
	.hub ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.hub li {
		padding: 0.35rem 0;
		color: var(--muted);
	}
	.hub a {
		font-weight: bold;
	}
</style>
