---
import 'devicon/devicon.min.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GitGraph from '../components/GitGraph.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getAllPosts } from '../lib/posts';

const latestPosts = (await getAllPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="home">
		<header class="hero">
			<h1 class="intro">{SITE_DESCRIPTION}</h1>
			<nav class="hub" aria-label="site navigation">
				<a href="/blog" data-astro-prefetch>blog</a>
				<a href="/lists" data-astro-prefetch>lists</a>
				<a href="/about" data-astro-prefetch>about</a>
			</nav>
		</header>
		<section class="about-me" aria-label="about me">
			<p>
				Hachem. AI software/infrastructure engineer, traveler by heart. Previously CTO at <a
					href="https://hyko.ai">hyko.ai</a
				>, now looking for a remote job and solo-founding an AI-native software boutique. I poke at
				the backend of reality; fractals, biomimicry, relegion, subconscious, and odd mushrooms.
				Looking for patterns hidden in plain sight. I try to be radically honest (sometimes too
				blunt). A dad who's happiest where the signal drops. I seek metamorphosis.
			</p>
			<div class="social-links">
				<a href="https://github.com/1hachem" target="_blank" rel="noopener noreferrer">
					<i class="logo devicon-github-plain" aria-hidden="true"></i>
					<span>github</span>
				</a>
				<a href="mailto:h@d4shi.com">
					<svg
						class="logo mail-icon"
						viewBox="0 0 16 16"
						width="14"
						height="14"
						fill="currentColor"
						aria-hidden="true"
					>
						<path
							d="M1.5 3h13c.28 0 .5.22.5.5v9c0 .28-.22.5-.5.5h-13a.5.5 0 0 1-.5-.5v-9c0-.28.22-.5.5-.5zm.5 1.35V12h12V4.35L8 8.8 2 4.35zM2.4 4l5.6 4.2L13.6 4H2.4z"
						></path>
					</svg>
					<span>h@d4shi.com</span>
				</a>
			</div>
		</section>
	</section>

	<div class="graph-teaser">
		<GitGraph preview />
		<span class="teaser-veil" aria-hidden="true"></span>
		<a class="teaser-cover" href="/about" data-astro-prefetch aria-label="More about me">
			<span class="teaser-cta">more about me →</span>
		</a>
	</div>

	{
		latestPosts.length > 0 && (
			<section class="home">
				<section class="latest" aria-label="latest posts">
					<h2 class="latest-label">latest</h2>
					<ul class="post-list">
						{latestPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} data-astro-prefetch>
									{post.data.title}
								</a>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</li>
						))}
					</ul>
				</section>
			</section>
		)
	}
</BaseLayout>

<style>
	/* widen the page just enough for the graph teaser to breathe */
	:global(main:has(.graph-teaser)) {
		max-width: calc(var(--max-width) + 14rem);
	}

	.home {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	/* clickable peek at the git-graph story, fading into the page (no box) */
	.graph-teaser {
		position: relative;
		max-width: calc(var(--max-width) + 12rem);
		margin: 0.5rem auto 2.5rem;
		max-height: 32rem;
		overflow: hidden;
	}
	/* fade the cropped bottom into the background */
	.teaser-veil {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 68%;
		background: linear-gradient(to bottom, transparent, var(--bg) 78%);
		pointer-events: none;
		z-index: 2;
	}
	/* the whole area is one link (graph itself is pointer-events:none) */
	.teaser-cover {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: block;
		text-decoration: none;
	}
	/* caption sits inside, on the faded area */
	.teaser-cta {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.4rem;
		text-align: center;
		font-size: 0.85rem;
		font-weight: bold;
		color: var(--accent);
	}
	.hero {
		text-align: center;
		padding: 3rem 0 3.5rem;
	}
	.intro {
		font-size: 1rem;
		font-weight: normal;
		color: var(--muted);
		white-space: pre-line;
		margin: 0 auto 1.75rem;
		max-width: 28rem;
	}
	.hub {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}
	.hub a {
		font-weight: bold;
		text-decoration: none;
	}
	.hub a:hover {
		text-decoration: underline;
	}
	.about-me {
		color: var(--muted);
		line-height: 1.6;
		margin-bottom: 2rem;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
	}
	.about-me p {
		margin: 0;
	}
	.social-links {
		display: flex;
		gap: 1.25rem;
		margin-top: 1rem;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.social-links .logo {
		font-size: 0.9rem;
		line-height: 1;
	}
	.mail-icon {
		width: 0.9rem;
		height: 0.9rem;
		flex-shrink: 0;
	}
	.latest {
		margin-top: 1rem;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
	}
	.latest-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0 0 0.25rem;
		font-weight: normal;
	}
	.post-list a {
		text-decoration: none;
	}
	.post-list a:hover {
		text-decoration: underline;
	}
</style>
