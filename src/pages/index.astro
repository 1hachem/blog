---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getAllPosts } from '../lib/posts';

const latestPosts = (await getAllPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="home">
		<header class="hero">
			<h1>{SITE_TITLE}</h1>
			<p class="intro">{SITE_DESCRIPTION}</p>
			<nav class="hub" aria-label="site navigation">
				<a href="/blog" data-astro-prefetch>blog</a>
				<a href="/lists" data-astro-prefetch>lists</a>
				<a href="/about" data-astro-prefetch>about</a>
			</nav>
		</header>
		{latestPosts.length > 0 && (
			<section class="latest" aria-label="latest posts">
				<h2 class="latest-label">latest</h2>
				<ul class="post-list">
					{latestPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} data-astro-prefetch>{post.data.title}</a>
							<span class="date"><FormattedDate date={post.data.pubDate} /></span>
						</li>
					))}
				</ul>
			</section>
		)}
	</section>
</BaseLayout>

<style>
	.home {
		max-width: 34rem;
		margin: 0 auto;
	}
	.hero {
		text-align: center;
		padding: 3rem 0 3.5rem;
	}
	.hero h1 {
		font-size: 2rem;
		letter-spacing: -0.01em;
		margin: 0 0 0.75rem;
	}
	.intro {
		color: var(--muted);
		white-space: pre-line;
		margin: 0 auto 1.75rem;
		max-width: 28rem;
	}
	.hub {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}
	.hub a {
		font-weight: bold;
		text-decoration: none;
	}
	.hub a:hover {
		text-decoration: underline;
	}
	.latest {
		margin-top: 1rem;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
	}
	.latest-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0 0 0.25rem;
		font-weight: normal;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.4rem 0;
	}
	.post-list a {
		text-decoration: none;
	}
	.post-list a:hover {
		text-decoration: underline;
	}
	.date {
		color: var(--muted);
		font-size: 0.85rem;
		flex-shrink: 0;
	}
	@media (max-width: 500px) {
		.post-list li {
			flex-direction: column;
			gap: 0.15rem;
		}
		.date {
			font-size: 0.75rem;
		}
	}
</style>
