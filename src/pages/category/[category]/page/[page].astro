---
import BaseHead from "../../../../components/BaseHead.astro";
import CategoryFilter from "../../../../components/CategoryFilter.astro";
import Footer from "../../../../components/Footer.astro";
import Header from "../../../../components/Header.astro";
import TimelinePostList from "../../../../components/TimelinePostList.astro";
import { POSTS_PER_PAGE, SITE_TITLE } from "../../../../consts";
import { getAllPosts, getCategories } from "../../../../lib/posts";

export async function getStaticPaths() {
	const allPosts = await getAllPosts();
	const categories = getCategories(allPosts);
	const paths = [];

	for (const cat of categories) {
		const catSlug = cat.toLowerCase().replace(/\s+/g, "-");
		const filtered = allPosts.filter((p) => p.data.category === cat);
		const totalPages = Math.ceil(filtered.length / POSTS_PER_PAGE);

		for (let page = 2; page <= totalPages; page++) {
			paths.push({
				params: { category: catSlug, page: String(page) },
				props: {
					label: cat,
					posts: filtered.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
					currentPage: page,
					totalPages,
					allCategories: categories,
				},
			});
		}
	}
	return paths;
}

const { label, posts, currentPage, totalPages, allCategories } = Astro.props;
const catSlug = Astro.params.category;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${label} — page ${currentPage} — ${SITE_TITLE}`} description={`Posts in ${label}`} />
	</head>
	<body>
		<Header />
		<main>
			<CategoryFilter categories={allCategories} active={catSlug} />
			<TimelinePostList posts={posts} currentPage={currentPage} totalPages={totalPages} baseURL={`/category/${catSlug}`} />
		</main>
		<Footer />
	</body>
</html>
