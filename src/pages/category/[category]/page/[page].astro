---
import CategoryFilter from "../../../../components/CategoryFilter.astro";
import TimelinePostList from "../../../../components/TimelinePostList.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from "../../../../consts";
import { getAllPosts, getCategories } from "../../../../lib/posts";

export async function getStaticPaths() {
	const allPosts = await getAllPosts();
	const categories = getCategories(allPosts);
	const paths = [];

	for (const cat of categories) {
		const catSlug = cat.label.toLowerCase().replace(/\s+/g, "-");
		const filtered = allPosts.filter((p) => p.data.category === cat.label);
		const totalPages = Math.ceil(filtered.length / POSTS_PER_PAGE);

		for (let page = 2; page <= totalPages; page++) {
			paths.push({
				params: { category: catSlug, page: String(page) },
				props: {
					label: cat.label,
					description: cat.description,
					posts: filtered.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
					currentPage: page,
					totalPages,
					allCategories: categories,
				},
			});
		}
	}
	return paths;
}

const { label, description, posts, currentPage, totalPages, allCategories } = Astro.props;
const catSlug = Astro.params.category;

const navLinks = [{ href: '/blog', label: '← blog' }, { href: '/', label: 'home' }];
---

<BaseLayout title={`${label} — page ${currentPage} — ${SITE_TITLE}`} description={description} navLinks={navLinks}>
	<p class="welcome">{SITE_DESCRIPTION}</p>
	<CategoryFilter categories={allCategories} active={catSlug} />
	<TimelinePostList posts={posts} currentPage={currentPage} totalPages={totalPages} baseURL={`/category/${catSlug}`} />
</BaseLayout>

<style>
	.welcome {
		margin-bottom: 1.5rem;
		color: var(--muted);
	}
</style>
