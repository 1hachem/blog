---
import BaseHead from '../../components/BaseHead.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TimelinePostList from '../../components/TimelinePostList.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getAllPosts, getCategories } from '../../lib/posts';

export async function getStaticPaths() {
	const allPosts = await getAllPosts();
	const categories = getCategories(allPosts);

	return categories.map((cat) => {
		const catSlug = cat.label.toLowerCase().replace(/\s+/g, '-');
		const filtered = allPosts.filter((p) => p.data.category === cat.label);
		const totalPages = Math.ceil(filtered.length / POSTS_PER_PAGE);
		return {
			params: { category: catSlug },
			props: { label: cat.label, description: cat.description, posts: filtered.slice(0, POSTS_PER_PAGE), totalPages, allCategories: categories },
		};
	});
}

const { label, description, posts, totalPages, allCategories } = Astro.props;
const catSlug = Astro.params.category;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${label} — ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<p class="welcome">{SITE_DESCRIPTION}</p>
			<CategoryFilter categories={allCategories} active={catSlug} />
			<TimelinePostList posts={posts} currentPage={1} totalPages={totalPages} baseURL={`/category/${catSlug}`} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.welcome {
		margin-bottom: 1.5rem;
		color: var(--muted);
	}
</style>
