---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitGraph from '../components/GitGraph.astro';

const navLinks = [{ href: '/', label: '← home' }, { href: '/blog', label: 'blog' }];
---

<BaseLayout title="about" description="my history as a git graph" navLinks={navLinks}>
    <h1>about</h1>
    <p>doubles down as my curriculum vitae</p>

	<p>Most about pages start with "I am." This one can't.</p>
	<p>
		By <a href="/blog/first-time-street-hypnosis">becoming a hypnotist</a> I learned the
        limits of every label we put on ourselves. So instead of "AI engineer this, CTO that", 
        here is my story as a <strong>git graph</strong> 
	</p>

	<GitGraph showLegend />
</BaseLayout>
