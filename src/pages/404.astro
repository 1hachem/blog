---
import BaseLayout from '../layouts/BaseLayout.astro';

const navLinks = [
	{ href: '/', label: '← home' },
	{ href: '/blog', label: 'blog' },
	{ href: '/about', label: 'about' },
];
---

<BaseLayout title="404" description="page not found" navLinks={navLinks} noindex>
	<p class="code">404</p>
	<p class="message">page not found</p>
</BaseLayout>

<style>
	.code {
		font-size: 3rem;
		font-weight: bold;
		margin: 0;
		line-height: 1;
	}
	.message {
		color: var(--muted);
		margin-top: 0.25rem;
	}
</style>
