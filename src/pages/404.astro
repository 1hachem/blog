---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`404 — ${SITE_TITLE}`} description="Page not found">
	<p class="code">404</p>
	<p class="message">page not found</p>
	<p><a href="/">← home</a></p>
</BaseLayout>

<style>
	.code {
		font-size: 3rem;
		font-weight: bold;
		margin: 0;
		line-height: 1;
	}
	.message {
		color: var(--muted);
		margin-top: 0.25rem;
	}
</style>
