{
	"$schema": "https://turbo.build/schema.json",
	"envMode": "loose",
	"remoteCache": {
		"enabled": true,
		"apiUrl": "https://turbo.d4shi.com",
		"teamSlug": "lisptc",
		"signature": true
	},
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**", ".astro/**"],
			"env": ["PUBLIC_R2_URL"],
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputLogs": "new-only"
		},
		"test": {
			"dependsOn": ["typecheck"],
			"outputs": []
		},
		"deploy": {
			"dependsOn": ["build"],
			"cache": false
		}
	}
}
